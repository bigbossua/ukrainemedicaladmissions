{
  "name": "ukrainemedicaladmissions-site",
  "private": true,
  "version": "0.1.0",
  "description": "Ukraine Medical Admissions \u2014 public website (Astro, static output)",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:links": "node tests/check-links.mjs",
    "test:whatsapp": "node tests/whatsapp.mjs",
    "test:meta": "node tests/check-meta.mjs",
    "test:redirects": "node tests/check-redirects.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:mobile": "node tests/mobile-widths.mjs",
    "test:a11y": "node tests/a11y.mjs",
    "test:perf": "node tests/perf.mjs",
    "test:release": "node tests/compare-backup.test.mjs",
    "build:staging": "STAGING=1 astro build --outDir dist-staging && node scripts/staging-postbuild.mjs",
    "test:staging": "npm run build:staging && node tests/staging-guard.mjs",
    "manifest": "node scripts/release-manifest.mjs",
    "compare:backup": "node scripts/compare-live-backup.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "test": "npm run test:records && npm run test:readiness && npm run test:publication && npm run test:evidence-tools && npm run test:allowlist && npm run test:search && npm run build && npm run test:links && npm run test:whatsapp && npm run test:meta && npm run test:redirects && npm run test:release-readiness && npm run test:publish-workflow && npm run test:ui && npm run test:mobile && npm run test:a11y && npm run test:audit && npm run test:floating && npm run test:perf && npm run test:release && npm run test:staging && npm run test:gate && npm run test:preview && npm run test:php && npm run test:journey && npm run test:verify-live && npm run test:seo",
    "build:preview": "PREVIEW_UNPUBLISHED=1 astro build --outDir dist-preview",
    "test:records": "node tests/records-evidence.mjs",
    "test:gate": "npm run build:preview && node tests/publication-gate.mjs",
    "test:preview": "node tests/preview-ui.mjs",
    "test:readiness": "node tests/readiness-logic.mjs",
    "test:php": "php -l public/api/enquiry.php && node tests/enquiry-php.mjs",
    "test:journey": "node tests/journey.mjs",
    "test:audit": "node tests/audit-regressions.mjs",
    "test:floating": "node tests/floating-cta.mjs",
    "test:policy": "node tests/publication-policy.mjs",
    "test:publication-build": "node tests/publication-build.mjs",
    "test:publication": "npm run test:policy && npm run test:publication-build",
    "report:publication": "node scripts/publication-report.mjs",
    "check:release": "node scripts/release-readiness.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "test:release-readiness": "node tests/release-readiness.mjs",
    "test:release-gate": "node tests/release-gate-selftest.mjs",
    "test:publish-workflow": "node tests/publish-workflow.mjs",
    "evidence:add": "node scripts/evidence-entry.mjs",
    "evidence:register": "cd .. && python3 -I site/scripts/make-evidence-register.py",
    "test:evidence-tools": "node tests/evidence-tools.mjs",
    "test:allowlist": "node tests/allowlist.mjs",
    "test:search": "node tests/name-search.mjs",
    "probe:access": "node scripts/probe-access.mjs",
    "test:verify-live": "node tests/verify-live-selftest.mjs",
    "audit:seo": "node scripts/seo-audit.mjs",
    "test:seo": "node scripts/seo-audit.mjs --no-lighthouse"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3"
  }
}
