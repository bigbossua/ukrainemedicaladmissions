---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import OwnerValue from '../../components/OwnerValue.astro';
import { SITE } from '../../lib/site';
// Owner details come from ONE file, src/lib/legal.mjs (completion guide: LEGAL_COMPLETION_CHECKLIST.md). A detail not yet
// supplied shows a visible "[to be supplied by the owner: …]" marker; the draft banner stays until legalPagesComplete().
import { documented, legalPagesComplete, ownerState } from '../../lib/legal.mjs';
const complete = legalPagesComplete();
const email: string = documented('contact.email');
const hosting: string = documented('processors.hosting');
// The representative line disappears only when the owner has answered "not needed" (false).
const representativeNotNeeded = ownerState('representative.needed') === 'supplied' && documented('representative.needed') === false;
const representativeNeeded = documented('representative.needed') === true;
---
<Base title="Privacy notice" description="How Ukraine Medical Admissions collects, uses, stores and protects personal information from enquiries and applications.">
  <div class="page-head"><div class="wrap"><span class="eyebrow">Legal</span><h1>Privacy notice</h1>
    {complete
      ? <p>Effective date: <OwnerValue path="effectiveDate" />. Version: <OwnerValue path="noticeVersion" />.</p>
      : <p>Draft for legal review — effective date: <OwnerValue path="effectiveDate" />. Version: <OwnerValue path="noticeVersion" />.</p>}
  </div></div>
  <Breadcrumbs items={[{ label: 'Privacy' }]} />
  <section style="padding-top:1rem"><div class="wrap prose">
    <h2>Who we are</h2>
    <p>Ukraine Medical Admissions (“we”) operates {SITE.url}. Contact: <a href={`mailto:${email}`}>{email}</a>.</p>
    <ul>
      <li>Legal entity: <OwnerValue path="entity.name" /></li>
      <li>Legal form: <OwnerValue path="entity.type" /></li>
      <li>Country of registration: <OwnerValue path="entity.country" /></li>
      <li>Registration number: <OwnerValue path="entity.registrationNumber" /></li>
      <li>Registered address: <OwnerValue path="entity.address" /></li>
      <li>Data controller: <OwnerValue path="controller.name" /></li>
      {!representativeNotNeeded && (
        <li>Representative in the UK or the EU: {representativeNeeded ? <OwnerValue path="representative.details" /> : <OwnerValue path="representative.needed" />}</li>
      )}
    </ul>
    <h2>What we collect and why</h2>
    <ul>
      <li><strong>Enquiries (contact form):</strong> name, email and your message. Used to reply to you. Legal basis: <OwnerValue path="lawfulBasis.enquiries" />.</li>
      <li><strong>Candidate profiles (the application form, stage 1):</strong> your name and email; your study plans (field of study, level, preferred universities and preferred start); your education history (highest level, qualification, awarding country, year, grading scale, and the subjects and grades you choose to enter, including results still outstanding); which documents you say you have, still need or are not sure about (we do not collect the documents themselves at this stage); the country where you live; your nationality, if you choose to give it; your preferred language for our emails; and your questions. Used to reply to you and to suggest next steps. Legal basis: <OwnerValue path="lawfulBasis.candidateProfiles" />.</li>
      <li><strong>Applications (when the secure dashboard is available):</strong> identity and academic documents you choose to upload. Used solely to prepare and, with your explicit confirmation, submit your application to the university. These are stored outside public web directories, access-controlled and retained only as long as needed. Legal basis: <OwnerValue path="lawfulBasis.applications" />.</li>
      <li><strong>Website analytics:</strong> none installed. We use no analytics or advertising trackers today; if we add privacy-respecting measurement, this notice will name the tool before it is switched on.</li>
    </ul>
    <h2>Sharing</h2>
    <p>We share your information with a university only when you confirm an official submission. We do not sell personal data and we do not use it for advertising.</p>
    <p>Service providers that store or carry your data for us:</p>
    <ul>
      <li>Website hosting and storage of form submissions: {hosting}</li>
      <li>Business mailbox that receives a copy of each submission: <OwnerValue path="processors.mailbox" /></li>
      <li>Where these providers store your data: <OwnerValue path="processingLocation" /></li>
      <li>Transfers to other countries: <OwnerValue path="internationalTransfers" /></li>
    </ul>
    <h2>Retention</h2>
    <ul>
      <li>Enquiries: <OwnerValue path="retention.enquiries" />.</li>
      <li>Candidate profiles: <OwnerValue path="retention.candidateProfiles" />.</li>
      <li>Copies of each submission in our business mailbox: <OwnerValue path="retention.mailboxCopies" />.</li>
      <li>Backups: <OwnerValue path="retention.backups" />.</li>
      <li>Application records and documents: for the duration of the application process and a limited period afterwards for accountability, then securely deleted. Period after an application ends: <OwnerValue path="retention.applicationRecords" />.</li>
    </ul>
    <h2>Your rights</h2>
    <p>You can ask for a copy of your data, correction, deletion, or restriction of processing, and withdraw consent at any time by emailing us. Where UK or EU data-protection law applies, you also have the right to complain to the relevant supervisory authority.</p>
    <p>Supervisory authority: <OwnerValue path="privacyAuthority" />.</p>
    <h2>Applicants under 18</h2>
    <p><OwnerValue path="under18Policy" /></p>
    <h2>Security</h2>
    <p>We use encrypted connections (HTTPS) and restrict access to personal data to the people who need it. Form submissions are stored outside the public web directories. We do not accept documents at this stage; when the secure application dashboard is available, it will keep a record of who accessed each file.</p>
    <h2>What else is stored with a submission</h2>
    <p>With each enquiry or candidate profile we store the date and time you sent it and, where enabled, a pseudonymised code derived from your IP address (a keyed hash that changes every month; the address itself is not stored), used only to detect abuse. Legal basis: <OwnerValue path="lawfulBasis.abuseDetection" />. Each submission is also delivered by e-mail to our business mailbox and kept there for the period given under Retention above.</p>
  </div></section>
</Base>
