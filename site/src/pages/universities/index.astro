---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import DraftBanner from '../../components/university/DraftBanner.astro';
import UniversityCard from '../../components/university/UniversityCard.astro';
import CompareTable from '../../components/university/CompareTable.astro';
import { getCollection } from 'astro:content';
import { SITE, PREVIEW } from '../../lib/site';
import { FIELDS, LEVELS } from '../../lib/fields';
import { isVisible, byShortName, fieldsOf, levelsOf, languagesOf, intakesOf } from '../../lib/records';

// Publication gate: unpublished records are listed only in PREVIEW builds (see lib/records.ts).
const universities = (await getCollection('universities')).filter(isVisible).sort(byShortName);
const records = universities.map((u) => u.data);
const drafts = records.filter((d) => !d.verification.publishable).length;
const allProgrammes = records.flatMap((d) => d.programmes);
const cities = [...new Set(records.map((d) => d.city))].sort();
const fields = fieldsOf(allProgrammes);
const levels = levelsOf(allProgrammes);
const languages = languagesOf(allProgrammes);
const intakes = intakesOf(allProgrammes);
const hasPrep = records.some((d) => d.preparatoryRoutes.length > 0);
---
<Base title="Medical universities in Ukraine: full list of medical colleges" description="Directory of Ukrainian medical universities (medical colleges) for international students: programmes, levels, language, city and verification status." suffix={false}>
  {PREVIEW && drafts > 0 && <DraftBanner kind="unpublished" text={`Preview build: this directory includes ${drafts} draft ${drafts === 1 ? 'record' : 'records'} that ${drafts === 1 ? 'is' : 'are'} not on the public site. Values marked “pending” are research leads, not verified facts.`} />}
  <div class="page-head">
    <div class="wrap">
      <span class="eyebrow">Directory</span>
      <h1>Medical universities in Ukraine</h1>
      <p>Filter by city, programme family, qualification level, teaching language, preparatory route and intake, then compare side by side. Each profile shows what has been verified against official sources and what is still being confirmed. Applicants from India often call these institutions medical colleges; in the UK they are usually called medical schools — this directory covers the same institutions under their official names.</p>
    </div>
  </div>
  <Breadcrumbs items={[{ label: 'Universities' }]} />

  <section style="padding-top:1rem">
    <div class="wrap">
      <form class="filters" data-filters aria-label="Filter universities">
        <label class="field">City
          <select name="city" data-filter="city"><option value="">All cities</option>{cities.map((c) => <option value={c}>{c}</option>)}</select>
        </label>
        <label class="field">Programme family
          <select name="field" data-filter="field"><option value="">All programmes</option>{fields.map((k) => <option value={k}>{(FIELDS as any)[k].label}</option>)}</select>
        </label>
        <label class="field">Qualification level
          <select name="level" data-filter="level"><option value="">Any level</option>{levels.map((k) => <option value={k}>{(LEVELS as any)[k]}</option>)}</select>
        </label>
        <label class="field">Teaching language
          <select name="language" data-filter="language"><option value="">Any language</option>{languages.map((l) => <option value={l}>{l}</option>)}</select>
        </label>
        <label class="field">Preparatory route
          <select name="prep" data-filter="prep"><option value="">Either</option>{hasPrep && <option value="yes">Offers a preparatory route</option>}<option value="no">No preparatory route recorded</option></select>
        </label>
        <label class="field">Intake
          <select name="intake" data-filter="intake"><option value="">Any intake</option>{intakes.map((i) => <option value={i}>{i}</option>)}</select>
        </label>
        <p class="filter-actions"><button type="reset" class="btn btn-secondary btn-sm" data-reset>Reset filters</button></p>
      </form>
      <p class="count" aria-live="polite"><span data-count>{universities.length}</span> {universities.length === 1 ? 'university' : 'universities'} listed. Level, language and intake filters use reported values; a profile marks each as verified or pending.</p>

      <div class="grid grid-3" data-list>
        {records.map((d) => <UniversityCard u={d} draft={!d.verification.publishable} />)}
      </div>
      <p class="note" data-empty hidden={universities.length > 0}>{universities.length === 0 ? 'No university profile has completed verification yet. Profiles are published one at a time, once every fact on them has been checked against official sources.' : 'No universities match these filters. Reset the filters to see every listed university; the directory expands as each institution is verified.'}</p>

      {universities.length > 0 && (
        <>
          <h2 style="margin-top:2.5rem" id="compare">Compare side by side</h2>
          <p class="prose">The table shows verified facts only. Where a cell says “awaiting verification” or “not published”, the university has not published the fact or we have not yet confirmed it — it is never guessed. Universities are listed alphabetically; no ranking is implied.</p>
          <CompareTable records={records} />
        </>
      )}

      <h2 style="margin-top:2.5rem">Which is the best medical university in Ukraine?</h2>
      <p class="prose">There is no official ranking of Ukrainian medical universities for international applicants, and we do not publish one. Compare institutions on facts you can verify on each profile: whether your programme is open to applicants from your country this intake, the language of instruction, the qualification title awarded, the published tuition fee with its academic year and payment schedule, other mandatory charges, and the entry requirements and documents. Where a fact has not yet been confirmed from an official source, the profile says so instead of guessing. The <a href="/tuition-fees/">medical college fees in Ukraine</a> guide explains how costs are published, and the <a href="/admissions/">admissions guide</a> covers the process.</p>
      <p class="note">Only filters supported by recorded data are offered. Fee-range and deadline filters will appear once official fee schedules have been confirmed. {SITE.disclaimer}</p>
    </div>
  </section>
  <CtaBand title="Not sure which university?" text="Start an application and tell us your course and country — we will help you shortlist." />
</Base>

<style>
  .filters { display: grid; gap: 1rem; margin-bottom: 1rem; }
  @media (min-width: 700px) { .filters { grid-template-columns: repeat(3, 1fr); } }
  .filter-actions { margin: 0; align-self: end; }
  .count { font-size: .9rem; color: var(--slate); }
</style>

<script>
  // Client-side filtering over data attributes written by UniversityCard. Exact-match keys: city, prep. List keys: fields, levels, languages, intakes.
  const MAP: Record<string, [string, 'exact' | 'list']> = { city: ['city', 'exact'], field: ['fields', 'list'], level: ['levels', 'list'], language: ['languages', 'list'], prep: ['prep', 'exact'], intake: ['intakes', 'list'] };
  const selects = document.querySelectorAll<HTMLSelectElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-list] > article');
  const count = document.querySelector('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  function apply() {
    let n = 0;
    cards.forEach((c) => {
      let ok = true;
      selects.forEach((s) => {
        if (!ok || !s.value) return;
        const [attr, mode] = MAP[s.dataset.filter!];
        const have = c.dataset[attr] ?? '';
        ok = mode === 'exact' ? have === s.value : have.split(' ').includes(s.value);
      });
      c.hidden = !ok; if (ok) n++;
    });
    if (count) count.textContent = String(n);
    if (empty) empty.hidden = n > 0;
  }
  selects.forEach((s) => s.addEventListener('change', apply));
  document.querySelector('[data-reset]')?.addEventListener('click', () => setTimeout(apply, 0));
</script>
