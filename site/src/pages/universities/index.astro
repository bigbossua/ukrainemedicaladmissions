---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import DraftBanner from '../../components/university/DraftBanner.astro';
import UniversityCard from '../../components/university/UniversityCard.astro';
import ResearchPreviewCard from '../../components/university/ResearchPreviewCard.astro';
import CompareTable from '../../components/university/CompareTable.astro';
import { groupPreviews, INSTITUTION_TYPES } from '../../lib/institution-types';
import { SITE, PREVIEW } from '../../lib/site';
import { FIELDS, LEVELS } from '../../lib/fields';
import { getListedUniversities, getResearchPreviews, fieldsOf, levelsOf, languagesOf, intakesOf } from '../../lib/records';

// Publication gate (lib/records.ts): production lists published records, as projections built by the publication policy,
// and RESEARCH PREVIEWS (N25): unpublished records that opt in, also as projections, labelled "not yet verified", with no
// filter data. PREVIEW builds list unpublished records raw, as drafts, instead of previews.
// Copy rule: this page states no university-specific fact. Everything it says about a university comes from the
// projections, and only verified values are shown as fact.
const universities = await getListedUniversities();
const previews = await getResearchPreviews();
const records = universities.map((u) => u.d);
const drafts = universities.filter((u) => u.draft).length;
const verifiedCount = universities.length - drafts;
const total = universities.length + previews.length;
// Filters are built from published profiles (and drafts in PREVIEW builds) only: a preview carries no city, programme,
// level, language or intake, so it never feeds or matches those filters.
const allProgrammes = records.flatMap((d) => d.programmes);
const cities = [...new Set(records.map((d) => d.city))].sort();
const fields = fieldsOf(allProgrammes);
const levels = levelsOf(allProgrammes);
const languages = languagesOf(allProgrammes);
const intakes = intakesOf(allProgrammes);
const hasPrep = records.some((d) => d.preparatoryRoutes.length > 0);
const factFilters = records.length > 0;
// Grouping by REPORTED institution type (lib/institution-types.ts; owner instruction 2026-10-25): a classification of the
// research leads, labelled as reported on every group. The filters below marked "as reported" use the same leads (city,
// programme areas); the fact filters use verified facts only.
const previewGroups = groupPreviews(previews);
const reportedCities = [...new Set(previews.map((u) => u.reported?.city).filter((c): c is string => typeof c === 'string' && c.length > 0))].sort();
const reportedFields = Object.keys(FIELDS).filter((k) => previews.some((u) => Array.isArray(u.reported?.programmeFields) && u.reported.programmeFields.includes(k)));
const reportedTypes = previewGroups.map((g) => g.key).filter((k) => k in INSTITUTION_TYPES);
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const summary = [plural(total, 'university', 'universities'), `${verifiedCount} verified`, previews.length ? `${previews.length} not yet verified` : '', drafts ? plural(drafts, 'draft', 'drafts') : '', 'alphabetical, not ranked'].filter(Boolean).join(' · ');
---
<Base title="Medical universities in Ukraine: list of medical colleges" description={`${total} Ukrainian universities in one directory, each marked verified or not yet verified. We show a fact only once checked, and we never rank universities.`} suffix={false}>
  {PREVIEW && drafts > 0 && <DraftBanner kind="unpublished" text={`Preview build: this directory includes ${drafts} draft ${drafts === 1 ? 'record' : 'records'} that ${drafts === 1 ? 'is' : 'are'} not on the public site. Values marked “pending” are research leads, not verified facts.`} />}
  <div class="page-head">
    <div class="wrap">
      <span class="eyebrow">Directory</span>
      <h1>Medical universities in Ukraine</h1>
      <p>The Ukrainian universities in our directory, in one list. A <strong>verified profile</strong> shows facts checked against official sources, each dated. A university marked <strong>not yet verified</strong> is one we are still researching: we show its name and what to check before you apply, never unconfirmed fees, programmes or dates. The list includes dedicated medical universities and multi-faculty universities; which medical, dental, pharmacy or nursing programmes each one offers is among the facts we confirm. In India these institutions are often called medical colleges; in the UK, medical schools.</p>
      <p class="head-summary" data-summary>{summary}</p>
    </div>
  </div>
  <Breadcrumbs items={[{ label: 'Universities' }]} />

  <section style="padding-top:1rem">
    <div class="wrap">
      {/* Hidden until the directory script runs: without JavaScript every university is listed anyway. */}
      <form class="filters" data-filters aria-label="Search the directory" role="search" hidden>
        <label class="field search">Search by university name
          <input type="search" name="q" data-search placeholder="e.g. Bukovinian, Pirogov" autocomplete="off" />
        </label>
        {reportedTypes.length > 1 && (
          <label class="field">Type (as reported)
            <select name="type" data-filter="type">
              <option value="">All types</option>
              {reportedTypes.map((k) => <option value={k}>{(INSTITUTION_TYPES as any)[k].group}</option>)}
            </select>
          </label>
        )}
        {reportedCities.length > 1 && (
          <label class="field">City (as reported)
            <select name="rcity" data-filter="rcity"><option value="">All cities</option>{reportedCities.map((c) => <option value={c}>{c}</option>)}</select>
          </label>
        )}
        {reportedFields.length > 1 && (
          <label class="field">Programme area (as reported)
            <select name="rfield" data-filter="rfield"><option value="">All programme areas</option>{reportedFields.map((k) => <option value={k}>{(FIELDS as any)[k].label}</option>)}</select>
          </label>
        )}
        {(verifiedCount > 0 && previews.length > 0 || drafts > 0) && (
          <label class="field">Show
            <select name="status" data-filter="status">
              <option value="">All universities</option>
              <option value="verified">Verified profiles only</option>
              {previews.length > 0 && <option value="preview">Not yet verified only</option>}
              {drafts > 0 && <option value="draft">Drafts (preview build)</option>}
            </select>
          </label>
        )}
        {factFilters && (
          <>
            <label class="field">City
              <select name="city" data-filter="city"><option value="">All cities</option>{cities.map((c) => <option value={c}>{c}</option>)}</select>
            </label>
            <label class="field">Programme family
              <select name="field" data-filter="field"><option value="">All programmes</option>{fields.map((k) => <option value={k}>{(FIELDS as any)[k].label}</option>)}</select>
            </label>
            <label class="field">Qualification level
              <select name="level" data-filter="level"><option value="">Any level</option>{levels.map((k) => <option value={k}>{(LEVELS as any)[k]}</option>)}</select>
            </label>
            <label class="field">Teaching language
              <select name="language" data-filter="language"><option value="">Any language</option>{languages.map((l) => <option value={l}>{l}</option>)}</select>
            </label>
            <label class="field">Preparatory route
              <select name="prep" data-filter="prep"><option value="">Either</option>{hasPrep && <option value="yes">Offers a preparatory route</option>}<option value="no">No preparatory route recorded</option></select>
            </label>
            <label class="field">Intake
              <select name="intake" data-filter="intake"><option value="">Any intake</option>{intakes.map((i) => <option value={i}>{i}</option>)}</select>
            </label>
          </>
        )}
        <p class="filter-actions"><button type="reset" class="btn btn-secondary btn-sm" data-reset>Clear</button></p>
      </form>
      <p class="count" aria-live="polite" aria-atomic="true">Showing <span data-count>{total}</span> of {total} <span data-noun>{total === 1 ? 'university' : 'universities'}</span>.{previews.length > 0 && ' Filters marked “as reported” use what public sources say about universities not yet verified.'}{factFilters && (PREVIEW ? ' Preview build: level, language and intake filters use reported values for drafts.' : ' The other filters use verified facts only, so universities not yet verified do not match them.')}</p>

      <p class="note near-note" data-near-match role="status" hidden>No listed name matches every word you typed. Universities with similar names can be different institutions, so check the full name before you choose.</p>
      <div data-list>
        {universities.length > 0 && (
          <div class="tier" role="region" aria-labelledby="verified-h" data-tier>
            <h2 id="verified-h">{PREVIEW && drafts ? 'Profiles and drafts' : 'Verified profiles'}</h2>
            <div class="grid grid-3">{universities.map((u) => <UniversityCard u={u.d} draft={u.draft} />)}</div>
          </div>
        )}
        {previews.length > 0 && (
          <div class="tier" role="region" aria-labelledby="research-h" data-tier>
            <h2 id="research-h">List of universities we are researching</h2>
            {verifiedCount === 0 && <p class="lead-note" data-empty-state><strong>No university profile has completed verification yet.</strong> Each university below is listed with what public sources report about it, marked “Reported”: its type, city and programme areas. We have not confirmed any of it on the university's own website or in a government register, and we show no fee, requirement, date or ranking until we have. We have not yet verified whether, where or how each one is teaching this academic year.</p>}
            {verifiedCount > 0 && <p class="lead-note">Each university below is listed with what public sources report about it, marked “Reported”; nothing has been confirmed on its official website yet.</p>}
            <details class="meaning">
              <summary>What “not yet verified” and “reported” mean</summary>
              <ul>
                <li>“Reported” is what public sources (listings, registers, the university's pages seen in search results) say. We have not yet read the university's facts on its own website or a Ukrainian government register.</li>
                <li>It is not a judgement about the university. It may or may not be admitting students for your intake; we simply have not confirmed it yet.</li>
                <li>A university moves to “Verified profiles” once its official name, website, address, current teaching statement and at least one programme open to international applicants, with its language, duration, intake and fee page, have been checked on official sources.</li>
              </ul>
            </details>
            {previewGroups.map((g) => (
              <div class="group" role="group" aria-labelledby={`group-${g.key}`} data-tier>
                <h3 id={`group-${g.key}`}>{g.title} <span class="group-count">({g.items.length})</span></h3>
                <p class="group-note">{g.note}</p>
                <div class="grid grid-3 previews">{g.items.map((u) => <ResearchPreviewCard u={u} headingLevel="h4" />)}</div>
              </div>
            ))}
          </div>
        )}
      </div>
      <p class="note" data-no-match role="status" hidden>No university name matches “<span data-query></span>”. We search university names only. Check the spelling, or <button type="button" class="linkish" data-reset-link>show all universities</button>. If the university is not in the list, choose “A university not listed here” when you <a href={SITE.ctaHref}>start your profile</a>.</p>
      {total === 0 && <p class="note" data-empty-state><strong>No university profile has completed verification yet.</strong> <a href={SITE.ctaHref}>{SITE.cta}</a> and tell us which university you are considering.</p>}

      <div class="cta-inline">
        <p><strong>University not in the list, or not sure which to choose?</strong> Start your candidate profile with your course, country and qualifications, and choose “A university not listed here” if you need to. We reply by email.</p>
        <a class="btn btn-primary" href={SITE.ctaHref}>{SITE.cta}</a>
      </div>

      {universities.length > 0 && (
        <>
          <h2 style="margin-top:2.5rem" id="compare">Compare side by side</h2>
          <p class="prose">The table shows verified facts only. Where a cell says “awaiting verification” or “not published”, the university has not published the fact or we have not yet confirmed it. It is never guessed. Universities are listed alphabetically; no ranking is implied.</p>
          <CompareTable records={records} />
        </>
      )}

      <div class="prose">
        <h2 style="margin-top:2.5rem" id="best">Which is the best medical university in Ukraine?</h2>
        <p>There is no official ranking of Ukrainian medical universities for international applicants, and we do not publish one. The right choice depends on you: the programme you want, your school-leaving qualification, your budget, the teaching language and the country where you plan to work.</p>
        <h3 id="compare-instead">What to compare instead</h3>
        <ul>
          <li>Is your programme open to applicants from your country for your intake, and in which language is it taught? Course guides: <a href="/courses/medicine/">medicine</a>, <a href="/courses/dentistry/">dentistry</a>, <a href="/courses/pharmacy/">pharmacy</a> and <a href="/courses/nursing/">nursing</a>.</li>
          <li>What qualification title is awarded, and does the regulator where you plan to work accept it?</li>
          <li>What is the tuition fee, for which academic year, with which payment schedule and other mandatory charges? <a href="/tuition-fees/">How to read a fee schedule</a>.</li>
          <li>What are the entry requirements and documents? <a href="/admissions/#readiness">How requirements are compared</a>.</li>
        </ul>
        <h3 id="no-ranking">Why a ranking can mislead</h3>
        <p>A league table turns many facts into one order chosen by its publisher, may measure research output rather than teaching, and can be old, unsourced or paid for by universities or agents. Check who publishes a list, what it measures and the year it describes.</p>

        <h2 id="official-websites">Check the official website before you send anything</h2>
        <p>Some third-party websites are made to look like a university's own site, with the university's name in the address or a copy of its logo. Before you send documents, personal details or money, check that the address matches the university's official domain (a verified profile shows it, with the date we checked it) and follow only the admission procedure the university publishes on its own website. <a href="/admissions/#official-sites">Apply through official channels only</a>.</p>
      </div>
      <p class="note">{SITE.disclaimer}</p>
    </div>
  </section>
  <CtaBand title="Not sure which university?" text="Start your candidate profile with your course, country and qualifications. We reply by email, and nothing is sent to a university." />
<script>
  // Client-side search and filters over data attributes written by UniversityCard and ResearchPreviewCard.
  // name: src/lib/name-search.mjs (full matches, or near matches under a caution so that separate institutions with
  // similar names are never presented as one). status: verified | preview | draft. Exact-match keys: city, prep. List
  // keys: fields, levels, languages, intakes. A not-yet-verified card carries no fact attributes, so a fact filter hides it.
  import { searchNames } from '../../lib/name-search.mjs';
  const MAP: Record<string, [string, 'exact' | 'list']> = { status: ['status', 'exact'], type: ['type', 'exact'], rcity: ['rcity', 'exact'], rfield: ['rfields', 'list'], city: ['city', 'exact'], field: ['fields', 'list'], level: ['levels', 'list'], language: ['languages', 'list'], prep: ['prep', 'exact'], intake: ['intakes', 'list'] };
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  if (form) form.hidden = false;
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const selects = document.querySelectorAll<HTMLSelectElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-list] article');
  const tiers = document.querySelectorAll<HTMLElement>('[data-tier]');
  const count = document.querySelector('[data-count]');
  const noun = document.querySelector('[data-noun]');
  const noMatch = document.querySelector<HTMLElement>('[data-no-match]');
  const nearMatch = document.querySelector<HTMLElement>('[data-near-match]');
  const query = document.querySelector('[data-query]');
  const cardList = Array.from(cards);
  function apply() {
    const found = searchNames(search?.value ?? '', cardList.map((c) => c.dataset.name ?? ''));
    let n = 0;
    cardList.forEach((c, i) => {
      let ok = found.show[i];
      selects.forEach((s) => {
        if (!ok || !s.value) return;
        const [attr, mode] = MAP[s.dataset.filter!];
        const have = c.dataset[attr] ?? '';
        ok = mode === 'exact' ? have === s.value : have.split(' ').includes(s.value);
      });
      c.hidden = !ok; if (ok) n++;
    });
    tiers.forEach((t) => { t.hidden = !t.querySelector('article:not([hidden])'); });
    if (count) count.textContent = String(n);
    if (noun) noun.textContent = cards.length === 1 ? 'university' : 'universities';
    if (query) query.textContent = search?.value ?? '';
    if (noMatch) noMatch.hidden = n > 0 || cards.length === 0;
    if (nearMatch) nearMatch.hidden = n === 0 || !(found.tier === 'near' || found.caution);
  }
  selects.forEach((s) => s.addEventListener('change', apply));
  search?.addEventListener('input', apply);
  // A shared or reloaded link such as /universities/?q=odessa opens with the search applied.
  const initial = new URLSearchParams(location.search).get('q');
  if (search && initial) { search.value = initial.slice(0, 80); apply(); }
  form?.addEventListener('submit', (e) => { e.preventDefault(); apply(); });
  form?.addEventListener('reset', () => setTimeout(apply, 0));
  document.querySelector('[data-reset-link]')?.addEventListener('click', () => { form?.reset(); setTimeout(() => { apply(); search?.focus(); }, 0); });
</script>
</Base>

<style>
  .head-summary { margin-top: .75rem !important; font-weight: 600; color: var(--yellow-400); }
  .filters { display: grid; gap: 0 1rem; margin-bottom: .25rem; align-items: end; }
  @media (min-width: 700px) { .filters { grid-template-columns: minmax(0, 2fr) auto; } .filters:has(select[name="status"]) { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto; } .filters:has(select[name="city"]), .filters:has(select[name="rcity"]) { grid-template-columns: repeat(3, 1fr); } .filters:has(select[name="rcity"]) .search { grid-column: 1 / -1; } }
  .filter-actions { margin: 0 0 1rem; }
  .filter-actions .btn { min-height: 44px; }
  .filters[hidden] { display: none; }
  .filters input::placeholder { color: var(--slate); opacity: 1; }
  .count { font-size: .9rem; color: var(--slate); margin-top: 0; }
  .near-note { margin: 0 0 .75rem; max-width: 80ch; }
  .tier { margin-top: 1.5rem; }
  .tier[hidden] { display: none; }
  .tier > h2 { font-size: 1.35rem; margin-bottom: .5rem; }
  .lead-note { max-width: 80ch; margin: 0 0 .75rem; }
  .meaning { max-width: 80ch; margin: 0 0 1.25rem; }
  .meaning summary { cursor: pointer; font-weight: 600; color: var(--navy-900); margin: 0; padding: .65rem 0; min-height: 44px; }
  .meaning summary:focus-visible { outline-offset: 2px; }
  .meaning ul { padding-left: 1.25rem; margin: .6rem 0 0; }
  .meaning li { margin-bottom: .35rem; }
  .previews { gap: .75rem; }
  .group { margin-top: 1.5rem; }
  .group[hidden] { display: none; }
  .group > h3 { font-size: 1.1rem; margin: 0 0 .25rem; }
  .group-count { color: var(--slate); font-weight: 500; }
  .group-note { margin: 0 0 .75rem; color: var(--slate); font-size: .9rem; max-width: 80ch; }
  .linkish { background: none; border: 0; padding: 0; font: inherit; color: var(--blue-600); text-decoration: underline; cursor: pointer; }
  .cta-inline { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; background: var(--blue-50); border-radius: var(--radius); padding: 1.1rem 1.4rem; margin: 2rem 0 0; }
  .cta-inline p { margin: 0; max-width: 62ch; }
</style>

