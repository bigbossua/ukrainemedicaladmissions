---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import DraftBanner from '../../components/university/DraftBanner.astro';
import UniversityProfile from '../../components/university/UniversityProfile.astro';
import { getCollection } from 'astro:content';
import { isVisible } from '../../lib/records';

export async function getStaticPaths() {
  // PUBLICATION GATE: a record with verification.publishable = false produces NO page in a production build.
  // A PREVIEW_UNPUBLISHED=1 build renders it for internal review only (noindex, no canonical, no JSON-LD, no sitemap).
  const universities = await getCollection('universities');
  return universities.filter(isVisible).map((u) => ({ params: { slug: u.data.slug }, props: { u } }));
}
const { u } = Astro.props;
const d = u.data;
const publishable = d.verification.publishable;
const draft = !publishable;
const title = `${d.shortName}: admissions & fees`;
const description = `${d.shortName}, ${d.city}: programmes for international students, language, fees and entry requirements — each marked verified or pending.`;
// Structured data only for a verified, publishable profile, and only from verified fields.
const v = (c: any) => (c.status === 'verified' && c.value ? c.value : undefined);
const jsonLd = publishable && v(d.officialName) ? [{
  '@context': 'https://schema.org', '@type': 'CollegeOrUniversity',
  name: v(d.officialName), alternateName: d.alternativeNames,
  url: v(d.website), address: v(d.address),
}] : [];
---
<Base title={title} description={description} noindex={draft} draft={draft} jsonLd={jsonLd} suffix={false}>
  {draft && <DraftBanner kind="unpublished" />}
  <UniversityProfile d={d} publishable={publishable} draft={draft} crumbs={[{ label: 'Universities', href: '/universities/' }, { label: d.shortName }]} />
  <CtaBand title={`Ready to apply to ${d.shortName}?`} text="Begin online — it takes a few minutes and nothing is sent to the university until you confirm." />
</Base>
