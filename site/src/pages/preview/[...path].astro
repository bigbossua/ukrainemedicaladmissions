---
/**
 * PREVIEW-ONLY routes. In a production build getStaticPaths returns [] so NOTHING under /preview/ exists.
 *   /preview/            — index of draft records and synthetic samples + directory/comparison layout demo
 *   /preview/<sample>/   — a synthetic sample record (src/content/samples), clearly separated from real records
 *   /preview/readiness/  — readiness check and document checklist demo (APPLICATION_SYSTEM_SPEC §12.2): a SYNTHETIC
 *                          candidate (src/lib/synthetic-candidate.mjs) against the synthetic sample record
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DraftBanner from '../../components/university/DraftBanner.astro';
import UniversityProfile from '../../components/university/UniversityProfile.astro';
import UniversityCard from '../../components/university/UniversityCard.astro';
import CompareTable from '../../components/university/CompareTable.astro';
import ReadinessDemo from '../../components/readiness/ReadinessDemo.astro';
import { PREVIEW } from '../../lib/site';
import { getListedUniversities, getPreviewSamples } from '../../lib/records';

export async function getStaticPaths() {
  if (!PREVIEW) return [];
  const samples = await getPreviewSamples();
  // The readiness demo runs against this synthetic sample only (never a real record).
  const demoRecord = samples.find((s) => s.synthetic && s.slug === 'example-medical-university') ?? null;
  return [
    { params: { path: undefined }, props: { kind: 'index' as const, s: null } },
    ...samples.map((s) => ({ params: { path: s.slug }, props: { kind: 'sample' as const, s } })),
    ...(demoRecord ? [{ params: { path: 'readiness' }, props: { kind: 'readiness' as const, s: demoRecord } }] : []),
  ];
}
const { kind, s } = Astro.props;
const samples = await getPreviewSamples();
const listed = await getListedUniversities();
const drafts = listed.filter((u) => u.draft);
const published = listed.filter((u) => !u.draft);
const hrefFor = (u: any) => (u.synthetic ? `/preview/${u.slug}/` : `/universities/${u.slug}/`);
const demoRecords = [...samples, ...drafts.map((x) => x.d)];
---
{kind === 'readiness' && s ? (
  <Base title="Readiness check demo — synthetic candidate and university" description="Worked example of the readiness check and document checklist using an invented candidate and an invented university. Preview build only." noindex draft suffix={false}>
    <DraftBanner kind="synthetic" text="Synthetic demonstration. Both the candidate and the university on this page are invented: no real person's data is used and Example Medical University is not a real institution. This page is built only for internal preview and never for the public site." />
    <ReadinessDemo record={s} publishedCount={published.length} />
  </Base>
) : kind === 'sample' && s ? (
  <Base title={`${s.shortName} — synthetic sample`} description="Synthetic sample record used to demonstrate the university-profile layout. Not a real university. Preview build only." noindex draft suffix={false}>
    <DraftBanner kind="synthetic" />
    <UniversityProfile d={s} publishable={false} draft={true} crumbs={[{ label: 'Preview', href: '/preview/' }, { label: s.shortName }]} directoryHref="/preview/" />
  </Base>
) : (
  <Base title="Preview index — drafts and samples" description="Internal preview of unpublished draft records and synthetic samples. Not part of the public site." noindex draft suffix={false}>
    <DraftBanner kind="unpublished" text="Preview build. Everything linked from this page is either an unpublished draft record (research leads, not verified facts) or a synthetic sample (invented values). None of it exists on the public site." />
    <div class="page-head"><div class="wrap"><span class="eyebrow">Internal preview</span><h1>Drafts and samples</h1><p>Review the record pipeline before anything is published: draft records built from research leads, synthetic sample records that demonstrate the layouts with verified-looking data, and the directory and comparison layouts with both.</p></div></div>
    <Breadcrumbs items={[{ label: 'Preview' }]} draft />
    <section style="padding-top:1rem"><div class="wrap">
      <h2>Publication status</h2>
      <div class="table-wrap" role="region" aria-label="Publication status of records" tabindex="0"><table>
        <thead><tr><th>Record</th><th>Type</th><th>Status</th><th>Programmes listed</th><th>Preparatory routes</th><th>Research references</th><th>Open questions</th><th>Publication check</th></tr></thead>
        <tbody>
          {published.map((u) => <tr><td><a href={`/universities/${u.d.slug}/`}>{u.d.shortName}</a></td><td>Real record</td><td><span class="badge badge-verified">Published</span></td><td>{u.d.programmes.length}</td><td>{u.d.preparatoryRoutes.length}</td><td>—</td><td>0</td><td>Passes</td></tr>)}
          {drafts.map((u) => <tr><td><a href={`/universities/${u.d.slug}/`}>{u.d.shortName}</a></td><td>Real record</td><td><span class="badge badge-pending">{u.flagged ? 'Flagged — blocked by the policy' : 'Draft — unpublished'}</span></td><td>{u.d.programmes.length}</td><td>{u.d.preparatoryRoutes.length}</td><td>{u.d.researchReferences.length}</td><td>{u.d.verification.openQuestions.length}</td><td>{u.failures.length} {u.failures.length === 1 ? 'failure' : 'failures'}</td></tr>)}
          {samples.map((u) => <tr><td><a href={`/preview/${u.slug}/`}>{u.shortName}</a></td><td>Synthetic sample</td><td><span class="badge badge-pending">Never publishable</span></td><td>{u.programmes.length}</td><td>{u.preparatoryRoutes.length}</td><td>—</td><td>—</td><td>—</td></tr>)}
        </tbody>
      </table></div>
      <p class="note">A draft record is published only when its publishable flag is set AND it passes the publication policy: every fact a page shows needs a matching verified entry in its evidence file (UNIVERSITY_DATA_REGISTER.md, "Publication policy (fail-closed)"). Each draft's profile lists what still blocks it. The synthetic sample exists to show what a verified profile looks like; its values are invented and its sources point to <code>example.invalid</code>.</p>

      <h2 style="margin-top:2.5rem">Directory layout demo (samples and drafts)</h2>
      <div class="grid grid-3" data-list>
        {demoRecords.map((d) => <UniversityCard u={d} href={hrefFor(d)} draft={true} />)}
      </div>

      <h2 style="margin-top:2.5rem">Comparison layout demo</h2>
      <p class="prose">Verified facts only: the synthetic sample fills its cells; the drafts show the “awaiting verification” state a real unverified record produces.</p>
      <CompareTable records={demoRecords} hrefFor={hrefFor} />

      <h2 style="margin-top:2.5rem">Readiness check demo</h2>
      <p class="prose">The readiness assessment and document checklist logic (APPLICATION_SYSTEM_SPEC.md §8.2, §8.3, §12.2) run with a synthetic candidate against the synthetic sample record: <a href="/preview/readiness/">readiness check: worked example</a>. Both the candidate and the university are invented.</p>
    </div></section>
  </Base>
)}
