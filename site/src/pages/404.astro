---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
// The title "Page not found" is what scripts/verify-live.mjs looks for on the live 404 response: keep it.
---
<Base title="Page not found" description="This page does not exist on Ukraine Medical Admissions. Try the universities we are researching, the fees guide, the FAQ or the home page." noindex={true} canonical={false}>
  <div class="page-head"><div class="wrap"><h1>Page not found</h1><p>This page does not exist or has moved.</p></div></div>
  <section><div class="wrap prose">
    <p>These pages may help:</p>
    <ul class="link-list">
      <li><a href="/universities/">The universities we are researching</a></li>
      <li><a href="/tuition-fees/">Tuition fees guide</a></li>
      <li><a href="/admissions/">Admissions guide</a></li>
      <li><a href="/faq/">Student FAQ</a></li>
      <li><a href="/">Home page</a></li>
    </ul>
    <p><a class="btn btn-primary" href={SITE.ctaHref}>{SITE.cta}</a></p>
  </div></section>
</Base>
