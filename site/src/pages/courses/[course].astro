---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Fact from '../../components/Fact.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/illustrations/Icon.astro';
import { getCollection } from 'astro:content';
import { COURSES, type CourseSlug } from '../../lib/courses';
import { SITE } from '../../lib/site';
import { isVisible, byShortName } from '../../lib/records';

export function getStaticPaths() {
  return Object.keys(COURSES).map((course) => ({ params: { course } }));
}
const course = Astro.params.course as CourseSlug;
const c = COURSES[course];
// Publication gate: unpublished records never appear here (lib/records.ts).
const universities = (await getCollection('universities'))
  .filter(isVisible)
  .sort(byShortName)
  .map((u) => ({ u, progs: u.data.programmes.filter((p) => p.field === course) }))
  .filter((x) => x.progs.length > 0);
const money = (m: any) => `${m.amount.toLocaleString('en-GB')} ${m.currency} per ${m.per} (${m.academicYear})`;
---
<Base title={c.title} description={c.description}>
  <div class="page-head"><div class="wrap course-head">
    <span class="head-ico" aria-hidden="true"><Icon name={course} size={32} /></span>
    <div><span class="eyebrow">Course</span><h1>{c.title}</h1><p>{c.description}</p></div>
  </div></div>
  <Breadcrumbs items={[{ label: 'Courses', href: '/courses/' }, { label: c.name }]} />
  <section style="padding-top:1rem"><div class="wrap">
    <p class="prose">{c.intro}</p>
    {'searchTermNote' in c && (
      <>
        <h2>{c.searchTermNote.heading}</h2>
        <p class="prose">{c.searchTermNote.text}</p>
        <p class="prose">See the <a href="/universities/">full list of medical universities in Ukraine</a> and current <a href="/tuition-fees/">MBBS fees in Ukraine</a> as published by each university.</p>
      </>
    )}
    <h2>Universities offering {c.name.toLowerCase()}</h2>
    {universities.length === 0 && <p class="note">No university has yet been verified for this programme. Profiles are added as each is confirmed from official sources.</p>}
    <div class="grid grid-2">
      {universities.map(({ u, progs }) => progs.map((p) => (
        <article class="card">
          <h3><a href={`/universities/${u.data.slug}/#${p.id}`}>{u.data.shortName}</a></h3>
          <p style="font-size:.9rem;color:var(--slate);margin:0">{u.data.city}{!u.data.verification.publishable && ' · '}{!u.data.verification.publishable && <span class="badge badge-pending">Verification in progress</span>}</p>
          <dl style="margin:0">
            <Fact label="Duration" claim={p.durationText.value ? p.durationText : p.durationYears} format={(v) => (typeof v === 'number' ? `${v} years` : String(v))} />
            <Fact label="Language" claim={p.language} />
            <Fact label="Tuition" claim={p.tuition} format={money} />
          </dl>
          <a class="more" href={`/universities/${u.data.slug}/#${p.id}`}>Full programme details →</a>
        </article>
      )))}
    </div>
    <h2 style="margin-top:2.5rem">What to check before you apply</h2>
    <ul class="prose">{c.whatToCheck.map((t) => <li>{t}</li>)}</ul>
    <div class="card qualify">
      <h3>Not sure whether you qualify yet?</h3>
      <p style="margin:0 0 .75rem">Tell us your course and the subjects and grades you have so far in a short, free enquiry. A readiness check is planned: once a programme's published requirements have been verified, it will compare them with your record and show what is met, what is missing and which documents you still need. It will not be an admission decision.</p>
      <a class="btn btn-primary btn-sm" href={`/apply/?course=${course}`}>{SITE.cta}</a>
    </div>
    <p class="note">Apply only through the university's official procedure. Some websites use a university's name in their address without being the university; every published profile here links the university's official domain, so check the address before you send anything.</p>
    <p class="prose">See the <a href="/admissions/">admissions guide</a> for the application process and the <a href="/tuition-fees/">tuition fees guide</a> for how costs are published and verified.</p>
    <p class="note">{SITE.disclaimer}</p>
  </div></section>
  <CtaBand title={`Apply for ${c.name.toLowerCase()}`} text="Start with a short online enquiry and tell us your preferred universities. Nothing is sent to a university until you confirm." />
</Base>

<style>
  .qualify { margin: 1.5rem 0; max-width: 820px; }
  .qualify .btn { align-self: flex-start; }
  .course-head { display: grid; gap: 1rem; align-items: start; }
  .head-ico {
    width: 3.5rem; height: 3.5rem; border-radius: 14px; display: grid; place-items: center;
    background: rgba(255, 255, 255, .08); border: 1px solid rgba(220, 232, 250, .28); color: var(--blue-100);
  }
  .head-ico :global(svg) { width: 32px; height: 32px; }
  @media (min-width: 700px) {
    .course-head { grid-template-columns: auto 1fr; gap: 1.5rem; }
    .head-ico { width: 4.5rem; height: 4.5rem; margin-top: .35rem; }
    .head-ico :global(svg) { width: 38px; height: 38px; }
  }
</style>
