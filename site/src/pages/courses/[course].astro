---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Fact from '../../components/Fact.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/illustrations/Icon.astro';
import { COURSES, type CourseSlug } from '../../lib/courses';
import { SITE, PREVIEW } from '../../lib/site';
import { getListedUniversities } from '../../lib/records';
import { viewClaim, formatMoney } from '../../lib/publication.mjs';

export function getStaticPaths() {
  return Object.keys(COURSES).map((course) => ({ params: { course } }));
}
const course = Astro.params.course as CourseSlug;
const c = COURSES[course];
const lower = c.name.toLowerCase();
// Publication gate (lib/records.ts): published records (projections) only; drafts only in PREVIEW builds.
// Research previews are never listed here: a course list implies the programme exists (tests/publication-gate.mjs).
const universities = (await getListedUniversities())
  .map((u) => ({ u, progs: u.d.programmes.filter((p: any) => p.field === course) }))
  .filter((x) => x.progs.length > 0);
const duration = (p: any) => (viewClaim(p.durationText, { preview: PREVIEW }).state !== 'tbc' ? p.durationText : p.durationYears);
// The policy's formatter, as on the fees page and profiles: year-by-year amounts and the payment schedule included.
const money = (m: any) => formatMoney(m, { compact: true });
---
<Base title={c.title} description={c.description}>
  <div class="page-head"><div class="wrap course-head">
    <span class="head-ico" aria-hidden="true"><Icon name={course} size={32} /></span>
    <div><span class="eyebrow">Course</span><h1>{c.h1}</h1><p>{c.lead}</p></div>
  </div></div>
  <Breadcrumbs items={[{ label: 'Courses', href: '/courses/' }, { label: c.name }]} />
  <section style="padding-top:1rem"><div class="wrap">
    <div class="prose">
      {c.sections.map((s) => (
        <>
          <h2 id={s.id}>{s.heading}</h2>
          {s.paragraphs?.map((para) => <p>{para.map((part) => (typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>))}</p>)}
          {s.checks && <ul class="checks">{s.checks.map((item) => <li>{item.map((part) => (typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>))}</li>)}</ul>}
          {s.after?.map((para) => <p>{para.map((part) => (typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>))}</p>)}
        </>
      ))}
      <h2 id="universities">Universities verified for {lower}</h2>
      {universities.length === 0 && <p>No university has been verified for this course yet. <a href="/universities/">See the universities we are researching</a>: we have not yet confirmed which courses each one offers.</p>}
      {universities.length > 0 && <p>Universities whose {lower} programme for international applicants we have verified are listed below. <a href="/universities/">See every university in the directory</a>, including those we are still researching.</p>}
    </div>
    {universities.length > 0 && (
      <div class="grid grid-2">
        {universities.map(({ u, progs }) => progs.map((p: any) => (
          <article class="card">
            <h3><a href={`/universities/${u.d.slug}/#${p.id}`}>{u.d.shortName}</a></h3>
            <p style="font-size:.9rem;color:var(--slate);margin:0">{u.d.editorialWithheld?.city ? 'City to be confirmed' : u.d.city}{u.draft && ' · '}{u.draft && <span class="badge badge-pending">Verification in progress</span>}</p>
            <dl style="margin:0">
              <Fact label="Duration" claim={duration(p)} format={(v) => (typeof v === 'number' ? `${v} years` : String(v))} />
              <Fact label="Language" claim={p.language} />
              <Fact label="Tuition" claim={p.tuition} format={money} />
            </dl>
            <a class="more" href={`/universities/${u.d.slug}/#${p.id}`}>Full programme details<span class="visually-hidden">: {p.name}, {u.d.shortName}</span> →</a>
          </article>
        )))}
      </div>
    )}
    <div class="card qualify">
      <h2>Not sure you qualify? Send us your grades</h2>
      <p>Tell us the course you want and the subjects and grades you have so far, and we will reply by email with suggested next steps.</p>
      <a class="btn btn-primary btn-sm" href={`${SITE.ctaHref}?course=${course}`}>{SITE.cta}</a>
    </div>
    <nav class="other-courses" aria-labelledby="other-courses-h">
      <h2 id="other-courses-h">Other courses</h2>
      <ul>{(Object.entries(COURSES) as [string, any][]).filter(([slug]) => slug !== course).map(([slug, c]) => <li><a href={`/courses/${slug}/`}>{c.name}</a>: {c.summary}</li>)}</ul>
    </nav>
    <p class="note">Before you send documents or money, read <a href="/admissions/#official-sites">how to check you are on the university’s official website</a>.</p>
    {universities.length > 0 && <p class="note">{SITE.disclaimer}</p>}
  </div></section>
  <CtaBand title={`Planning to study ${lower}?`} text="Tell us your grades and the universities you are considering. It is free to start, and nothing is sent to a university until you confirm." />
</Base>

<style>
  .checks li::marker { color: var(--blue-600); }
  .qualify { margin: 2rem 0 1.5rem; max-width: 820px; }
  .other-courses { max-width: 820px; margin: 0 0 1.5rem; }
  .other-courses h2 { font-size: 1.2rem; margin: 0 0 .5rem; }
  .other-courses ul { padding-left: 1.1rem; margin: 0; }
  .other-courses li { margin-bottom: .4rem; }
  .qualify h2 { font-size: 1.2rem; margin: 0; }
  .qualify p { margin: 0 0 .75rem; }
  .qualify .btn { align-self: flex-start; }
  .course-head { display: grid; gap: 1rem; align-items: start; }
  .head-ico {
    width: 3.5rem; height: 3.5rem; border-radius: 14px; display: grid; place-items: center;
    background: rgba(255, 255, 255, .08); border: 1px solid rgba(220, 232, 250, .28); color: var(--blue-100);
  }
  .head-ico :global(svg) { width: 32px; height: 32px; }
  @media (min-width: 700px) {
    .course-head { grid-template-columns: auto 1fr; gap: 1.5rem; }
    .head-ico { width: 4.5rem; height: 4.5rem; margin-top: .35rem; }
    .head-ico :global(svg) { width: 38px; height: 38px; }
  }
</style>
