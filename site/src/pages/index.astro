---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/illustrations/Icon.astro';
import HeroIllustration from '../components/illustrations/HeroIllustration.astro';
import ApplicationJourney from '../components/illustrations/ApplicationJourney.astro';
import { getCollection } from 'astro:content';
import { isVisible, byShortName } from '../lib/records';
import { SITE } from '../lib/site';
import { COURSES, type CourseSlug } from '../lib/courses';

// Publication gate: unpublished records never appear on the home page (lib/records.ts).
const universities = (await getCollection('universities')).filter(isVisible).sort(byShortName);
// Card text comes from lib/courses.ts: no duration, qualification or availability is stated as a fact.
const courses = (Object.entries(COURSES) as [CourseSlug, (typeof COURSES)[CourseSlug]][]).map(([slug, c]) => ({ slug, name: c.name, blurb: c.summary }));
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  email: SITE.email,
  logo: `${SITE.url}/brand/uma-emblem-light.svg`,
  description: SITE.description,
}, {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
}];
---
<Base title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero on-dark">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">International medical admissions</span>
        <h1>Independent, verified admissions support for medical universities in Ukraine.</h1>
        <p>Start a free online enquiry today. University profiles, entry requirements and fees appear here only once each has been checked against the university's official source.</p>
        <div class="cta-row">
          <a class="btn btn-on-dark" href={SITE.ctaHref}>{SITE.cta}</a>
          <a class="btn btn-ghost" href="/universities/">Browse universities</a>
        </div>
        <div class="trust">
          <div><b>Every published fact dated</b>, with its official source</div>
          <div><b>Medicine · Dentistry · Pharmacy · Nursing</b> listed only once verified</div>
          <div><b>Four clear stages</b> from enquiry to official submission</div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-art" aria-hidden="true"><HeroIllustration /></div>
        <aside class="hero-card" aria-labelledby="start-title">
          <h2 id="start-title">Start your application</h2>
          <form action="/apply/" method="get">
            <label class="field">Course
              <select name="course">
                <option value="">Choose a course</option>
                {courses.map((c) => <option value={c.slug}>{c.name}</option>)}
              </select>
            </label>
            <label class="field">University
              <select name="university">
                <option value="">Help me choose</option>
                {universities.map((u) => <option value={u.data.slug}>{u.data.shortName}</option>)}
                <option value="unlisted">A university not listed here</option>
              </select>
            </label>
            <button class="btn btn-primary" type="submit">{SITE.cta} →</button>
            <small>No fee to start. Nothing is sent to a university until you confirm. Please do not send document scans at this stage.</small>
          </form>
        </aside>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Why students use us</span>
        <h2>Independent guidance. Facts published only once checked.</h2>
      </div>
      <div class="grid grid-3">
        <div class="card card-link"><div class="ico"><Icon name="dated" /></div><h3>Official sources, dated</h3><p>We publish a fee, deadline or programme detail only after checking it against the university's official source, and we show the date we checked it. Anything not yet checked is marked as awaiting confirmation.</p><a class="more" href="/about/#verification">How we verify →</a></div>
        <div class="card card-link"><div class="ico"><Icon name="compare" /></div><h3>Compare side by side</h3><p>As profiles pass verification, their programmes, languages, entry requirements, tuition and application windows appear side by side in one comparison table.</p><a class="more" href="/universities/">Compare universities →</a></div>
        <div class="card card-link"><div class="ico"><Icon name="journey" /></div><h3>One application journey</h3><p>Four clear stages, from your first enquiry to official submission through the university's own procedure. A document checklist and status updates are planned.</p><a class="more" href="/admissions/#stages">See the process →</a></div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Universities</span>
        <h2>Medical universities in Ukraine</h2>
        <p>Our directory grows one verified profile at a time. A profile is published only after its core facts have been checked against the university's own website; <a href="/about/#verification">see how we verify</a>.</p>
      </div>
      {universities.length === 0 && <p class="note">No university profile has completed verification yet. The first profiles are queued for verification against official sources; each will appear here, dated, as soon as it passes.</p>}
      <div class="grid grid-3">
        {universities.map((u) => (
          <article class="card">
            <h3><a href={`/universities/${u.data.slug}/`}>{u.data.shortName}</a></h3>
            <div class="chips">
              <span>{u.data.city}</span>
              {u.data.programmes.filter((p) => p.internationalAdmission.value !== false).map((p) => <span>{p.name}</span>)}
              {!u.data.verification.publishable && <span class="badge badge-pending">Verification in progress</span>}
            </div>
            <a class="more" href={`/universities/${u.data.slug}/`}>View profile →</a>
          </article>
        ))}
      </div>
      <p class="after-grid"><a class="btn btn-secondary" href="/universities/">All universities</a></p>
    </div>
  </section>

  <section>
    <div class="wrap grid grid-2 courses-split">
      <div class="section-head">
        <span class="eyebrow">Courses</span>
        <h2>Programmes for international students</h2>
        <p>Programme details are listed only where availability has been confirmed from the university's official pages. Duration, entry requirements and degree titles are specific to each programme and follow each university's own terminology.</p>
      </div>
      <div class="grid grid-2">
        {courses.map((c) => <div class="card card-link"><div class="ico"><Icon name={c.slug} /></div><h3>{c.name}</h3><p>{c.blurb}</p><a class="more" href={`/courses/${c.slug}/`}>Explore {c.name.toLowerCase()} →</a></div>)}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>From enquiry to official submission</h2>
        <p>Today you start with a short online enquiry. The later stages are planned and are shown here so you know exactly what each one will mean.</p>
      </div>
      <ApplicationJourney />
      <p class="note journey-note">We support your application. {SITE.disclaimer} We do not guarantee admission, visas or recognition.</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero illustration sits behind the start card on wide screens only (from 1080 px, where enough of it shows
     around the card); the card stays the focus and phones/tablets stay uncluttered. */
  .hero-visual { position: relative; }
  .hero-visual .hero-card { position: relative; z-index: 1; }
  .hero-art { display: none; }
  @media (min-width: 1080px) {
    .hero-art { display: block; position: absolute; z-index: 0; inset: -110px -40px -130px -60px; pointer-events: none; }
  }
  .after-grid { margin: 1.5rem 0 0; }
  /* Stack the intro above the course cards until there is room for both side by side. */
  .courses-split { align-items: start; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .courses-split { grid-template-columns: 1fr 1.35fr; gap: 2.5rem; } }
  .courses-split > .section-head { margin-bottom: 0; }
  .journey-note { margin-top: 2rem; }
</style>
