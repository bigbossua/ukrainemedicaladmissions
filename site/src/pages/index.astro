---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/illustrations/Icon.astro';
import HeroIllustration from '../components/illustrations/HeroIllustration.astro';
import ApplicationJourney from '../components/illustrations/ApplicationJourney.astro';
import { getListedUniversities, getResearchPreviews } from '../lib/records';
import { SITE } from '../lib/site';
import { groupPreviews } from '../lib/institution-types';
import { COURSES, type CourseSlug } from '../lib/courses';

// Publication gate (lib/records.ts): only published records (projections) appear on the home page; drafts only in PREVIEW builds.
const universities = await getListedUniversities();
// Research previews (N25): unpublished records that opt in, as projections; labelled "not yet verified", name only.
const previews = await getResearchPreviews();
const total = universities.length + previews.length;
// Grouped by REPORTED institution type, as on /universities/ (lib/institution-types.ts): a labelled classification of
// the research leads; each name carries its reported city. No other claim.
const previewGroups = groupPreviews(previews);
// Featured selection (owner instruction 2026-10-25: not all 45 on the home page): the complete "state medical universities"
// group as reported, alphabetical, no ranking; every other group is a counted link into the directory filtered by type.
const featuredGroup = previewGroups.find((g) => g.key === 'state-medical-university');
const otherGroups = previewGroups.filter((g) => g.key !== 'state-medical-university');
// Card text comes from lib/courses.ts: no duration, qualification or availability is stated as a fact. The count beside each
// course is how many research previews REPORT that programme area in public sources (never a confirmation).
const reportedCounts: Record<string, number> = {};
for (const u of previews) for (const f of (u.reported?.programmeFields ?? []) as string[]) reportedCounts[f] = (reportedCounts[f] ?? 0) + 1;
const courses = (Object.entries(COURSES) as [CourseSlug, (typeof COURSES)[CourseSlug]][]).map(([slug, c]) => ({ slug, name: c.name, blurb: c.summary, reported: reportedCounts[slug] ?? 0 }));
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: `${SITE.url}/`,
  email: SITE.email,
  // Google asks for an Organization logo of at least 112 x 112 px: the 512 px emblem, not the 64 px SVG.
  logo: `${SITE.url}/android-chrome-512x512.png`,
  description: SITE.description,
}, {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: `${SITE.url}/`,
}];
---
<Base title="Ukraine Medical Admissions: independent admissions help" description={`Free, independent help applying to medical universities in Ukraine: ${total} universities with reported and verified facts clearly labelled, and an online start.`} suffix={false} jsonLd={jsonLd}>
  <section class="hero on-dark">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">International medical admissions</span>
        <h1>Independent help applying to medical universities in Ukraine.</h1>
        <p>For international students planning medicine, dentistry, pharmacy or nursing in Ukraine. Tell us what you want to study and the qualifications you have; we reply by email with answers and your next steps. Our directory of {total} universities says plainly what is reported in public sources and what we have verified on official websites.</p>
        <div class="cta-row">
          <a class="btn btn-on-dark" href={SITE.ctaHref}>{SITE.cta}</a>
          <a class="btn btn-ghost" href="/universities/">Browse universities</a>
        </div>
        <div class="trust">
          <div><b>Free to start</b> a short online form, no documents</div>
          <div><b>We reply by email</b> with answers and next steps</div>
          <div><b>Nothing goes to a university</b> without your confirmation</div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-art" aria-hidden="true"><HeroIllustration /></div>
        <aside class="hero-card" aria-labelledby="start-title">
          <h2 id="start-title">Start your application</h2>
          <form action="/apply/" method="get">
            <label class="field">Course
              <select name="course">
                <option value="">Choose a course</option>
                {courses.map((c) => <option value={c.slug}>{c.name}</option>)}
              </select>
            </label>
            <label class="field">University
              <select name="university">
                <option value="">Help me choose</option>
                {universities.map((u) => <option value={u.d.slug}>{u.d.shortName}</option>)}
                {previewGroups.map((g) => <optgroup label={`${g.title} (not yet verified)`}>{g.items.map((u) => <option value={u.slug}>{u.shortName} (not yet verified)</option>)}</optgroup>)}
                <option value="unlisted">A university not listed here</option>
              </select>
            </label>
            <button class="btn btn-primary" type="submit">{SITE.cta} →</button>
            <small>No fee to start. Nothing is sent to a university until you confirm. Please do not send document scans at this stage.</small>
          </form>
        </aside>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Why use this service</span>
        <h2>Independent guidance you can check</h2>
        <p>We are not an agent for any university. We help you compare, prepare and apply through each university's own procedure, and we never dress up a lead as a fact.</p>
      </div>
      <div class="grid grid-3">
        <div class="card card-link"><div class="ico"><Icon name="compare" /></div><h3>Know what to confirm</h3><p>Each university page lists what to check before you apply: the programme, the teaching language, the fee and its academic year, entry requirements and recognition at home.</p><a class="more" href="/universities/">See the universities →</a></div>
        <div class="card card-link"><div class="ico"><Icon name="dated" /></div><h3>Fees explained before figures</h3><p>How to read a fee schedule, what “per year” leaves out and which charges to ask about. A fee appears here only with its academic year and the date we checked it.</p><a class="more" href="/tuition-fees/">Tuition fees guide →</a></div>
        <div class="card card-link"><div class="ico"><Icon name="journey" /></div><h3>Clear next steps</h3><p>Start with a short enquiry; we reply by email. Four stages take you from enquiry to official submission through the university's own procedure, with nothing sent until you confirm.</p><a class="more" href="/admissions/#stages">See the process →</a></div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Reported or verified?</span>
        <h2>Two labels, one rule: no fact without its source</h2>
        <p>Every university page uses the same two labels, so you always know how much weight a line can carry.</p>
      </div>
      <div class="grid grid-2 labels">
        <div class="card">
          <p class="label-row"><span class="rep-label">Reported</span><span class="badge badge-pending">Not yet verified</span></p>
          <h3>Reported in public sources</h3>
          <p>What listings, registers and the university's own pages seen in search results say: the institution type, city, programme areas and website address. We show these as leads to check, with where we saw them and when. No fee, requirement, date or operating status is ever shown this way.</p>
        </div>
        <div class="card">
          <p class="label-row"><span class="badge badge-verified">Verified</span></p>
          <h3>Verified on an official source</h3>
          <p>A fact we have read on the university's official website or in a Ukrainian government register, kept with its source address and the date we checked it, and reviewed before each intake. Only verified facts appear as fees, requirements, deadlines or programme details.</p>
          <a class="link-standalone" href="/about/#verification">How we verify →</a>
        </div>
      </div>
    </div>
  </section>

  <section id="universities">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Universities</span>
        <h2>{universities.length > 0 ? 'Medical universities in Ukraine' : `${total} universities in one directory`}</h2>
        <p>{previews.length > 0 ? 'Grouped by reported type, each with its reported city and programme areas. Open a university to see what public sources report, what we have verified and what to check before you apply.' : 'A university appears here once its core facts have been checked against its official website.'} <a href="/about/#verification">How we verify</a>.</p>
      </div>
      {total === 0 && <p class="note">No university profile has completed verification yet. Each will appear here, dated, as soon as it passes.</p>}
      {universities.length > 0 && (
        <div class="grid grid-3">
          {universities.map((u) => (
            <article class="card">
              <h3><a href={`/universities/${u.d.slug}/`}>{u.d.shortName}</a></h3>
              <div class="chips">
                <span>{u.d.editorialWithheld?.city ? 'City to be confirmed' : u.d.city}</span>
                {/* A projection lists only programmes the policy shows as open to international applicants. */}
                {u.d.programmes.filter((p: any) => !u.draft || p.internationalAdmission.value !== false).map((p: any) => <span>{p.name}</span>)}
                {u.draft ? <span class="badge badge-pending">Draft — verification in progress</span> : <span class="badge badge-verified">Verified profile</span>}
              </div>
              <a class="more" href={`/universities/${u.d.slug}/`}>View profile<span class="visually-hidden">: {u.d.shortName}</span> →</a>
            </article>
          ))}
        </div>
      )}
      {featuredGroup && (
        <div class="featured">
          <h3 class="featured-title">{featuredGroup.title} <span class="muted">({featuredGroup.items.length}, as reported; alphabetical, not ranked)</span></h3>
          <p class="featured-note">{featuredGroup.note} Facts appear once verified on each university's official website.</p>
          <ul class="featured-list" aria-label={`${featuredGroup.title}, as reported, not yet verified`}>
            {featuredGroup.items.map((u) => (
              <li class="card-link"><a href={`/universities/${u.slug}/`}>{u.shortName}</a>{u.reported?.city && <span class="rcity">{u.reported.city}</span>}<span class="badge badge-pending">Not yet verified</span></li>
            ))}
          </ul>
        </div>
      )}
      {otherGroups.length > 0 && (
        <div class="browse">
          <h3 class="featured-title">Browse the rest by reported type</h3>
          <ul class="browse-list">
            {otherGroups.map((g) => <li><a class="link-standalone" href={`/universities/?type=${g.key}`}>{g.title}<span class="muted"> ({g.items.length})</span></a></li>)}
          </ul>
        </div>
      )}
      <p class="after-grid"><a class="btn btn-secondary" href="/universities/">{total > 0 ? `Search all ${total} universities` : 'Browse universities'}</a></p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap grid grid-2 courses-split">
      <div class="section-head">
        <span class="eyebrow">Courses</span>
        <h2>Programmes for international students</h2>
        <p>Each guide explains what to check for that programme: the qualification title, the teaching language, entry requirements and recognition at home. Programme details for a university are listed only once confirmed from its official pages.</p>
        <p class="area-links">Universities reporting each area in public sources (not yet verified): {courses.map((c, i) => <>{i > 0 && ' · '}<a href={`/universities/?rfield=${c.slug}`}>{c.name} ({c.reported})</a></>)}.</p>
      </div>
      <div class="grid grid-2">
        {courses.map((c) => <div class="card card-link"><div class="ico"><Icon name={c.slug} /></div><h3>{c.name}</h3><p>{c.blurb}</p><a class="more" href={`/courses/${c.slug}/`}>Explore {c.name.toLowerCase()} →</a></div>)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>From enquiry to official submission</h2>
        <p>Today you start with a short online enquiry. The later stages are planned and are shown here so you know exactly what each one will mean.</p>
      </div>
      <ApplicationJourney />
      <p class="note journey-note">We support your application. {SITE.disclaimer} We do not guarantee admission, visas or recognition.</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero illustration sits behind the start card on wide screens only (from 1080 px, where enough of it shows
     around the card); the card stays the focus and phones/tablets stay uncluttered. */
  .hero-visual { position: relative; }
  .hero-visual .hero-card { position: relative; z-index: 1; }
  .hero-art { display: none; }
  @media (min-width: 1080px) {
    .hero-art { display: block; position: absolute; z-index: 0; inset: -110px -40px -130px -60px; pointer-events: none; }
  }
  .after-grid { margin: 2rem 0 0; }
  .muted { color: var(--slate); font-weight: 500; }
  .featured { margin-top: .5rem; }
  .featured-title { font-size: 1.1rem; margin: 0 0 .35rem; }
  .featured-note { color: var(--slate); margin: 0 0 1rem; max-width: 72ch; }
  .featured-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; }
  @media (min-width: 640px) { .featured-list { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .featured-list { grid-template-columns: repeat(3, 1fr); } }
  .featured-list li { position: relative; display: grid; gap: .25rem; padding: 1rem 1.1rem; min-height: 48px; background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--yellow-400); border-radius: var(--radius-sm); }
  .featured-list li:focus-within { outline: 3px solid var(--blue-600); outline-offset: 2px; }
  .featured-list a { font-weight: 600; text-decoration: none; color: var(--navy-900); line-height: 1.3; }
  .featured-list a::after { content: ""; position: absolute; inset: 0; }
  .featured-list a:hover { text-decoration: underline; }
  .featured-list .badge { justify-self: start; margin-top: .15rem; }
  .rcity { color: var(--slate); font-size: .9rem; }
  .browse { margin-top: 2rem; }
  .browse-list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem .75rem; }
  .browse-list a { text-decoration: none; color: var(--navy-900); font-weight: 600; background: var(--mist); border: 1px solid var(--line); border-radius: 999px; padding: .35rem 1rem; }
  .browse-list a:hover { border-color: var(--blue-600); color: var(--blue-600); }
  .labels .card h3 { margin-top: .25rem; }
  .label-row { display: flex; gap: .5rem; align-items: center; margin: 0; }
  .rep-label { font-size: .72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--navy-800); background: var(--blue-50); border-radius: 3px; padding: .1rem .4rem; }
  .area-links { font-size: .95rem; margin-top: 1rem; }
  /* Stack the intro above the course cards until there is room for both side by side. */
  .courses-split { align-items: start; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .courses-split { grid-template-columns: 1fr 1.35fr; gap: 2.5rem; } }
  .courses-split > .section-head { margin-bottom: 0; }
  .journey-note { margin-top: 2rem; }
</style>
