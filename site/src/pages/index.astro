---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';

const universities = (await getCollection('universities')).sort((a, b) => a.data.shortName.localeCompare(b.data.shortName));
const courses = [
  { slug: 'medicine', name: 'Medicine', blurb: 'Six-year programmes leading to a medical degree.' },
  { slug: 'dentistry', name: 'Dentistry', blurb: 'Five-year dental programmes.' },
  { slug: 'nursing', name: 'Nursing', blurb: 'Bachelor-level nursing routes.' },
  { slug: 'pharmacy', name: 'Pharmacy', blurb: 'Pharmacy degrees for international students.' },
];
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  email: SITE.email,
  logo: `${SITE.url}/brand/uma-emblem-light.svg`,
  description: SITE.description,
}, {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
}];
---
<Base title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero on-dark">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">International medical admissions</span>
        <h1>Study medicine in Ukraine with a clear, verified path.</h1>
        <p>Compare Ukrainian medical universities, understand real entry requirements and published tuition fees, and apply online with step-by-step support.</p>
        <div class="cta-row">
          <a class="btn btn-on-dark" href={SITE.ctaHref}>{SITE.cta}</a>
          <a class="btn btn-ghost" href="/universities/">Browse universities</a>
        </div>
        <div class="trust">
          <div><b>Verified &amp; dated</b> university information</div>
          <div><b>Medicine · Dentistry · Nursing · Pharmacy</b> programmes</div>
          <div><b>One application journey</b> from enquiry to decision</div>
        </div>
      </div>
      <aside class="hero-card" aria-labelledby="start-title">
        <h2 id="start-title">Start your application</h2>
        <form action="/apply/" method="get">
          <label class="field">Course
            <select name="course">
              <option value="">Choose a course</option>
              {courses.map((c) => <option value={c.slug}>{c.name}</option>)}
            </select>
          </label>
          <label class="field">University
            <select name="university">
              <option value="">Help me choose</option>
              {universities.map((u) => <option value={u.data.slug}>{u.data.shortName}</option>)}
            </select>
          </label>
          <button class="btn btn-primary" type="submit">{SITE.cta} →</button>
          <small>Save and resume anytime. No fee to start. We never share your documents without consent.</small>
        </form>
      </aside>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Why students use us</span>
      <h2>Independent guidance, verified information.</h2>
      <div class="grid grid-3">
        <div class="card"><div class="ico" aria-hidden="true">✓</div><h3>Verified university data</h3><p>Every fee, deadline and programme is checked against official university sources, dated, and marked if it is still awaiting confirmation.</p><a class="more" href="/about/#verification">How we verify →</a></div>
        <div class="card"><div class="ico" aria-hidden="true">⇄</div><h3>Compare side by side</h3><p>Tuition, language of instruction, duration and entry requirements in one directory.</p><a class="more" href="/universities/">Compare universities →</a></div>
        <div class="card"><div class="ico" aria-hidden="true">◎</div><h3>One application journey</h3><p>A clear document checklist and status updates from your first enquiry to the university's decision.</p><a class="more" href="/admissions/">See the process →</a></div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <span class="eyebrow">Universities</span>
      <h2>Medical universities in Ukraine</h2>
      <p class="prose">Our directory grows one verified profile at a time. Profiles still under verification are clearly marked.</p>
      <div class="grid grid-3">
        {universities.map((u) => (
          <article class="card">
            <h3><a href={`/universities/${u.data.slug}/`}>{u.data.shortName}</a></h3>
            <div class="chips">
              <span>{u.data.city}</span>
              {u.data.programmes.filter((p) => p.internationalAdmission.value !== false).map((p) => <span>{p.name}</span>)}
              {!u.data.verification.publishable && <span class="badge badge-pending">Verification in progress</span>}
            </div>
            <a class="more" href={`/universities/${u.data.slug}/`}>View profile →</a>
          </article>
        ))}
      </div>
      <p style="margin-top:1.5rem"><a class="btn btn-secondary" href="/universities/">All universities</a></p>
    </div>
  </section>

  <section>
    <div class="wrap grid grid-2" style="align-items:start">
      <div>
        <span class="eyebrow">Courses</span>
        <h2>Programmes for international students</h2>
        <p>Programme details are listed only where availability has been confirmed with the university. Degree titles follow each university's own terminology.</p>
      </div>
      <div class="grid grid-2">
        {courses.map((c) => <div class="card"><h3>{c.name}</h3><p>{c.blurb}</p><a class="more" href={`/courses/${c.slug}/`}>Explore →</a></div>)}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <span class="eyebrow">How it works</span>
      <h2>From enquiry to enrolment, step by step</h2>
      <div class="grid grid-4 steps" style="margin-top:1.5rem">
        <div class="step"><h3>Choose</h3><p>Pick a course and shortlist universities using verified data.</p></div>
        <div class="step"><h3>Apply online</h3><p>Complete the application form; save and resume at any time.</p></div>
        <div class="step"><h3>Documents</h3><p>Upload securely against a clear checklist; we review and advise.</p></div>
        <div class="step"><h3>Track</h3><p>Follow every status change until the university's official decision.</p></div>
      </div>
      <p class="note">We support your application. {SITE.disclaimer} We do not guarantee admission, visas or recognition.</p>
    </div>
  </section>

  <CtaBand />
</Base>
