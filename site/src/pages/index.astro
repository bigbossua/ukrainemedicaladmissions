---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/illustrations/Icon.astro';
import HeroIllustration from '../components/illustrations/HeroIllustration.astro';
import ApplicationJourney from '../components/illustrations/ApplicationJourney.astro';
import { getListedUniversities, getResearchPreviews } from '../lib/records';
import { SITE } from '../lib/site';
import { groupPreviews } from '../lib/institution-types';
import { COURSES, type CourseSlug } from '../lib/courses';

// Publication gate (lib/records.ts): only published records (projections) appear on the home page; drafts only in PREVIEW builds.
const universities = await getListedUniversities();
// Research previews (N25): unpublished records that opt in, as projections; labelled "not yet verified", name only.
const previews = await getResearchPreviews();
const total = universities.length + previews.length;
// Grouped by REPORTED institution type, as on /universities/ (lib/institution-types.ts): a labelled classification of
// the research leads; each name carries its reported city. No other claim.
const previewGroups = groupPreviews(previews);
// Card text comes from lib/courses.ts: no duration, qualification or availability is stated as a fact.
const courses = (Object.entries(COURSES) as [CourseSlug, (typeof COURSES)[CourseSlug]][]).map(([slug, c]) => ({ slug, name: c.name, blurb: c.summary }));
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: `${SITE.url}/`,
  email: SITE.email,
  // Google asks for an Organization logo of at least 112 x 112 px: the 512 px emblem, not the 64 px SVG.
  logo: `${SITE.url}/android-chrome-512x512.png`,
  description: SITE.description,
}, {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: `${SITE.url}/`,
}];
---
<Base title="Ukraine Medical Admissions: independent admissions help" description="Free, independent help applying to medical universities in Ukraine. Browse the universities we are researching and start your application online." suffix={false} jsonLd={jsonLd}>
  <section class="hero on-dark">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">International medical admissions</span>
        <h1>Independent help applying to medical universities in Ukraine.</h1>
        <p>Tell us what you want to study and the qualifications you have, and we reply by email with your next steps. Entry requirements and fees appear here only once checked against the university's official source.</p>
        <div class="cta-row">
          <a class="btn btn-on-dark" href={SITE.ctaHref}>{SITE.cta}</a>
          <a class="btn btn-ghost" href="/universities/">Browse universities</a>
        </div>
        <div class="trust">
          <div><b>Free to start</b> a short online form, no documents</div>
          <div><b>We reply by email</b> with answers and next steps</div>
          <div><b>Nothing goes to a university</b> without your confirmation</div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-art" aria-hidden="true"><HeroIllustration /></div>
        <aside class="hero-card" aria-labelledby="start-title">
          <h2 id="start-title">Start your application</h2>
          <form action="/apply/" method="get">
            <label class="field">Course
              <select name="course">
                <option value="">Choose a course</option>
                {courses.map((c) => <option value={c.slug}>{c.name}</option>)}
              </select>
            </label>
            <label class="field">University
              <select name="university">
                <option value="">Help me choose</option>
                {universities.map((u) => <option value={u.d.slug}>{u.d.shortName}</option>)}
                {previewGroups.map((g) => <optgroup label={`${g.title} (not yet verified)`}>{g.items.map((u) => <option value={u.slug}>{u.shortName} (not yet verified)</option>)}</optgroup>)}
                <option value="unlisted">A university not listed here</option>
              </select>
            </label>
            <button class="btn btn-primary" type="submit">{SITE.cta} →</button>
            <small>No fee to start. Nothing is sent to a university until you confirm. Please do not send document scans at this stage.</small>
          </form>
        </aside>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What you get here</span>
        <h2>Independent guidance you can check</h2>
      </div>
      <div class="grid grid-3">
        <div class="card card-link"><div class="ico"><Icon name="dated" /></div><h3>Fees explained before figures</h3><p>Learn how to read a university fee schedule, what “per year” leaves out and which charges to ask about. A fee appears here only with its academic year and the date we checked it.</p><a class="more" href="/tuition-fees/">Tuition fees guide →</a></div>
        <div class="card card-link"><div class="ico"><Icon name="compare" /></div><h3>Know what to check</h3><p>Each university page lists what to confirm before you apply: the programme, teaching language, fee and academic year, entry requirements and recognition at home. Verified profiles add the facts side by side.</p><a class="more" href="/universities/">See the universities →</a></div>
        <div class="card card-link"><div class="ico"><Icon name="journey" /></div><h3>One application journey</h3><p>Four clear stages, from your first enquiry to official submission through the university's own procedure.</p><a class="more" href="/admissions/#stages">See the process →</a></div>
      </div>
    </div>
  </section>

  <section class="alt" id="universities">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Universities</span>
        <h2>{universities.length > 0 ? 'Medical universities in Ukraine' : 'Universities we are researching'}</h2>
        <p>{previews.length > 0 ? 'Each university is listed by reported type with its reported city; fees, programmes and requirements appear once each is checked on the university’s official website. Open a university to see what public sources report and what to check before you apply.' : 'A university appears here once its core facts have been checked against its official website.'} <a href="/about/#verification">How we verify</a>.</p>
      </div>
      {total === 0 && <p class="note">No university profile has completed verification yet. Each will appear here, dated, as soon as it passes.</p>}
      {universities.length > 0 && (
        <div class="grid grid-3">
          {universities.map((u) => (
            <article class="card">
              <h3><a href={`/universities/${u.d.slug}/`}>{u.d.shortName}</a></h3>
              <div class="chips">
                <span>{u.d.editorialWithheld?.city ? 'City to be confirmed' : u.d.city}</span>
                {/* A projection lists only programmes the policy shows as open to international applicants. */}
                {u.d.programmes.filter((p: any) => !u.draft || p.internationalAdmission.value !== false).map((p: any) => <span>{p.name}</span>)}
                {u.draft ? <span class="badge badge-pending">Draft — verification in progress</span> : <span class="badge badge-verified">Verified profile</span>}
              </div>
              <a class="more" href={`/universities/${u.d.slug}/`}>View profile<span class="visually-hidden">: {u.d.shortName}</span> →</a>
            </article>
          ))}
        </div>
      )}
      {previewGroups.map((g) => (
        <div class="research-group">
          <h3 class="research-group-title">{g.title} <span class="research-group-count">({g.items.length})</span></h3>
          <ul class="research-list" aria-label={`${g.title} we are researching (not yet verified), alphabetical`}>
            {g.items.map((u) => <li><a href={`/universities/${u.slug}/`}>{u.shortName}</a>{u.reported?.city && <span class="rcity"> · {u.reported.city}</span>} <span class="badge badge-pending">Not yet verified</span></li>)}
          </ul>
        </div>
      ))}
      <p class="after-grid"><a class="btn btn-secondary" href="/universities/">{total > 0 ? `Search the directory (${total})` : 'Browse universities'}</a></p>
    </div>
  </section>

  <section>
    <div class="wrap grid grid-2 courses-split">
      <div class="section-head">
        <span class="eyebrow">Courses</span>
        <h2>Programmes for international students</h2>
        <p>Programme details are listed only where availability has been confirmed from the university's official pages. Duration, entry requirements and degree titles are specific to each programme and follow each university's own terminology.</p>
      </div>
      <div class="grid grid-2">
        {courses.map((c) => <div class="card card-link"><div class="ico"><Icon name={c.slug} /></div><h3>{c.name}</h3><p>{c.blurb}</p><a class="more" href={`/courses/${c.slug}/`}>Explore {c.name.toLowerCase()} →</a></div>)}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>From enquiry to official submission</h2>
        <p>Today you start with a short online enquiry. The later stages are planned and are shown here so you know exactly what each one will mean.</p>
      </div>
      <ApplicationJourney />
      <p class="note journey-note">We support your application. {SITE.disclaimer} We do not guarantee admission, visas or recognition.</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero illustration sits behind the start card on wide screens only (from 1080 px, where enough of it shows
     around the card); the card stays the focus and phones/tablets stay uncluttered. */
  .hero-visual { position: relative; }
  .hero-visual .hero-card { position: relative; z-index: 1; }
  .hero-art { display: none; }
  @media (min-width: 1080px) {
    .hero-art { display: block; position: absolute; z-index: 0; inset: -110px -40px -130px -60px; pointer-events: none; }
  }
  .after-grid { margin: 1.5rem 0 0; }
  .research-list { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: .5rem 1rem; }
  @media (min-width: 640px) { .research-list { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .research-list { grid-template-columns: repeat(3, 1fr); } }
  .research-list li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .4rem .75rem; padding: .1rem .9rem; min-height: 48px; background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--yellow-400); border-radius: var(--radius-sm); }
  .research-list li { position: relative; }
  .research-group { margin-top: 1.25rem; }
  .research-group-title { font-size: 1.05rem; margin: 0 0 .5rem; }
  .research-group-count { color: var(--slate); font-weight: 500; }
  .research-list li:focus-within { outline: 3px solid var(--blue-600); outline-offset: 2px; }
  .research-list a { font-weight: 600; text-decoration: none; color: var(--navy-900); display: inline-flex; align-items: center; min-height: 44px; }
  .research-list .badge { margin-block: .5rem; }
  .rcity { color: var(--slate); font-size: .9rem; }
  .research-list a::after { content: ""; position: absolute; inset: 0; }
  .research-list a:hover { text-decoration: underline; }
  /* Stack the intro above the course cards until there is room for both side by side. */
  .courses-split { align-items: start; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .courses-split { grid-template-columns: 1fr 1.35fr; gap: 2.5rem; } }
  .courses-split > .section-head { margin-bottom: 0; }
  .journey-note { margin-top: 2rem; }
</style>
