---
import { WHATSAPP, whatsappHref } from '../lib/whatsapp';
// A quiet, secondary contact link (never a floating widget): "Apply Online Now" stays the primary call to action.
// page: the page the visitor is reading, named in the pre-filled message (src/lib/whatsapp.ts); omit for the general one.
// tone: "dark" on navy backgrounds (call-to-action band), "light" elsewhere.
// The visible text sits word for word inside the accessible name (WCAG 2.5.3, label in name).
interface Props { page?: string; tone?: 'light' | 'dark'; }
const { page, tone = 'light' } = Astro.props;
const visible = `WhatsApp: ${WHATSAPP.display}`;
---
<a class:list={['wa-link', tone]} href={whatsappHref(page)} target="_blank" rel="noopener noreferrer"
  aria-label={`Contact Ukraine Medical Admissions on ${visible} (opens in WhatsApp)`} data-whatsapp>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.6-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3Z"/></svg>
  <span>{visible}</span>
</a>
<style>
  .wa-link { display: inline-flex; align-items: center; gap: .45rem; min-height: 44px; font-weight: 600; text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px; }
  .wa-link svg { flex: none; }
  .wa-link.light { color: var(--blue-600); }
  .wa-link.dark { color: #fff; }
</style>
