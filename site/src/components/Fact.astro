---
/**
 * Renders one claim as a definition row, through the publication policy's view (src/lib/publication.mjs viewClaim):
 *  - a projected claim (published profile) shows its value ONLY when the policy shows it; otherwise "To be confirmed"
 *    with the plain-language explanation. It never prints a record note.
 *  - a raw record claim (drafts and samples) is rendered as reported, with "Verification pending", ONLY in PREVIEW
 *    builds; outside PREVIEW a raw claim is always "To be confirmed".
 */
import { formatDate, PREVIEW } from '../lib/site';
import { viewClaim } from '../lib/publication.mjs';
interface Props {
  label: string;
  claim: unknown;
  format?: (v: any) => string;
  /** Plain-language explanation shown with "To be confirmed" (owner decision 2026-10-11: explain the limitation clearly). */
  tbcText?: string;
}
const { label, claim, format, tbcText } = Astro.props;
const v = viewClaim(claim, { preview: PREVIEW });
let display: string | null = null;
if (v.state !== 'tbc') {
  try { display = format ? format(v.value) : Array.isArray(v.value) ? v.value.join(', ') : String(v.value); } catch { display = null; }
}
const state = display && display.trim() ? v.state : 'tbc';
---
<div class="fact">
  <dt>{label}</dt>
  <dd>
    {state === 'verified' ? (
      <>
        {display} <span class="badge badge-verified">Verified</span>
        <small>Source: {v.source ? <a href={v.source} rel="nofollow noopener">official page</a> : 'official document'}{v.checked && ` · checked ${formatDate(v.checked)}`}</small>
      </>
    ) : state === 'pending' ? (
      <>
        <span class="tbc">{display}</span> <span class="badge badge-pending">Verification pending</span>
        <small>Reported value — not yet confirmed against an official source.</small>
      </>
    ) : (
      <>
        <span class="badge badge-pending">To be confirmed</span>
        <small>{tbcText ?? v.reason}</small>
      </>
    )}
  </dd>
</div>
