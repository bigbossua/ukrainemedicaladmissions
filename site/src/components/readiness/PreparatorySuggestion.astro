---
/**
 * A preparatory route shown beneath readiness results ONLY when a result is "not met" and the route's required
 * claims are verified (readiness.mjs `preparatorySuggestion`). Quotes the university's own progression wording and
 * always carries the standing sentence. With no suggestion, says plainly that nothing is suggested.
 */
import { formatDate } from '../../lib/site';
import { PREP_STANDING } from '../../lib/readiness.mjs';
interface Suggestion {
  routeId: string; name: string; progressionText: string; source: string; checked: string | null;
  facts: { key: string; label: string; value: string; source: string; checked: string | null }[];
  standing: string; triggeredBy: string[];
}
interface Props { suggestion: Suggestion | null; emptyText: string; because?: string }
const { suggestion: s, emptyText, because } = Astro.props;
---
{s ? (
  <article class="prep" data-prep-suggestion>
    <h3>{s.name}</h3>
    {because && <p class="why">{because}</p>}
    <h4>What completing the course gives, in the university's own words</h4>
    <blockquote>{s.progressionText}</blockquote>
    <p class="src">Source: <a href={s.source} rel="nofollow noopener">official page<span class="visually-hidden"> for the preparatory route</span></a>{s.checked && ` · checked ${formatDate(s.checked)}`}</p>
    {s.facts.length > 0 && (
      <dl>
        {s.facts.map((f) => <div class="fact"><dt>{f.label}</dt><dd>{f.value} <span class="badge badge-verified">Verified</span></dd></div>)}
      </dl>
    )}
    <p class="standing">{s.standing ?? PREP_STANDING}</p>
  </article>
) : <p class="note" data-prep-none>{emptyText}</p>}
<style>
  .prep { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; background: var(--blue-50); }
  .prep h3 { margin-bottom: .5rem; }
  .prep h4 { font-size: .95rem; margin: 1rem 0 .4rem; }
  .why { margin: 0; color: var(--slate); }
  blockquote { margin: 0 0 .5rem; padding: .75rem 1rem; border-left: 4px solid var(--blue-600); background: #fff; border-radius: 8px; }
  .src { font-size: .8rem; color: var(--slate); margin: 0 0 .75rem; }
  dl { margin: 0 0 .75rem; }
  .standing { font-size: .9rem; color: var(--navy-900); font-weight: 600; margin: 0; }
</style>
