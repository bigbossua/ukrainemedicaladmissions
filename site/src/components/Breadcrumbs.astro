---
import { SITE, STAGING } from '../lib/site';
import { serializeJsonLd } from '../lib/publication.mjs';
interface Props { items: { label: string; href?: string }[]; /** Draft (preview-only) page: emit no structured data. */ draft?: boolean }
const { items, draft = false } = Astro.props;
const trail = [{ label: 'Home', href: '/' }, ...items];
// BreadcrumbList structured data (omitted in staging builds and on draft pages, like all JSON-LD). The last item carries no URL.
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href && i < trail.length - 1 ? { item: new URL(c.href, SITE.url).href } : {}),
  })),
};
---
<nav class="crumbs wrap" aria-label="Breadcrumb">
  <ol>
    {trail.map((c, i) => (
      <li>{c.href && i < trail.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
    ))}
  </ol>
</nav>
{/* serializeJsonLd escapes < > & U+2028 U+2029 so a label can never close the script element. */}
{!STAGING && !draft && <script type="application/ld+json" set:html={serializeJsonLd(ld)} />}
