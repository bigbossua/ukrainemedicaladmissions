---
/**
 * Calm abstract hero illustration: layered document sheets with a checklist, a small note, a compass and a
 * dotted route ending in a tick. Depicts no institution, building, landmark, flag, logo, person or
 * medical cliché. Purely decorative (aria-hidden); the hero text carries the meaning.
 * Brand colours only (navy / blue, one small yellow accent). Drawn in-repo 2026-10-11;
 * register row in VISUAL_AUDIT_AND_IMAGE_REGISTER.md §11.
 */
const dial = Array.from({ length: 12 }, (_, i) => {
  const a = (i * Math.PI) / 6;
  return { x: +(54 * Math.sin(a)).toFixed(2), y: +(-54 * Math.cos(a)).toFixed(2) };
});
---
<svg class="art" viewBox="0 0 580 540" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <!-- soft halo behind the form card -->
  <defs>
    <radialGradient id="uma-hero-halo">
      <stop offset="0" stop-color="#2F7BE5" stop-opacity=".26" />
      <stop offset=".6" stop-color="#1A5FC8" stop-opacity=".1" />
      <stop offset="1" stop-color="#1A5FC8" stop-opacity="0" />
    </radialGradient>
  </defs>
  <ellipse cx="290" cy="270" rx="288" ry="268" fill="url(#uma-hero-halo)" />

  <!-- small note, top left -->
  <g transform="rotate(-9 170 62)">
    <rect x="96" y="22" width="150" height="96" rx="14" fill="#15325F" stroke="#DCE8FA" stroke-opacity=".22" stroke-width="1.5" />
    <rect x="116" y="44" width="70" height="8" rx="4" fill="#DCE8FA" opacity=".45" />
    <rect x="116" y="62" width="104" height="6" rx="3" fill="#DCE8FA" opacity=".2" />
    <rect x="116" y="76" width="88" height="6" rx="3" fill="#DCE8FA" opacity=".2" />
  </g>

  <!-- back sheet, top right -->
  <g transform="rotate(-6 430 170)">
    <rect x="318" y="8" width="230" height="300" rx="20" fill="#15325F" stroke="#DCE8FA" stroke-opacity=".2" stroke-width="1.5" />
    <rect x="344" y="34" width="96" height="9" rx="4.5" fill="#DCE8FA" opacity=".3" />
  </g>

  <!-- front sheet with checklist, top right -->
  <g transform="rotate(5 410 190)">
    <rect x="282" y="20" width="250" height="320" rx="20" fill="#0F2A52" stroke="#DCE8FA" stroke-opacity=".32" stroke-width="1.5" />
    <rect x="308" y="44" width="118" height="11" rx="5.5" fill="#DCE8FA" opacity=".6" />
    <!-- done -->
    <rect x="308" y="72" width="18" height="18" rx="5" fill="#2F7BE5" />
    <path d="m312 81 4 4 7-8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="338" y="77" width="150" height="8" rx="4" fill="#DCE8FA" opacity=".3" />
    <!-- done -->
    <rect x="308" y="102" width="18" height="18" rx="5" fill="#2F7BE5" />
    <path d="m312 111 4 4 7-8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="338" y="107" width="122" height="8" rx="4" fill="#DCE8FA" opacity=".3" />
    <!-- outstanding -->
    <rect x="309" y="133" width="16" height="16" rx="4.5" fill="none" stroke="#DCE8FA" stroke-opacity=".55" stroke-width="1.5" />
    <rect x="338" y="137" width="138" height="8" rx="4" fill="#DCE8FA" opacity=".18" />
  </g>

  <!-- dotted route along the bottom, from the compass to a tick -->
  <path d="M168 478C250 505 360 508 470 470" fill="none" stroke="#2F7BE5" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="0.5 13" />
  <circle cx="494" cy="460" r="20" fill="#0F2A52" stroke="#2F7BE5" stroke-width="2" />
  <path d="m485 460 6 6 11-12" fill="none" stroke="#DCE8FA" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />

  <!-- compass, bottom left -->
  <g transform="translate(104 466)">
    <circle r="62" fill="#0B1F3F" stroke="#DCE8FA" stroke-opacity=".3" stroke-width="1.5" />
    <circle r="44" fill="none" stroke="#DCE8FA" stroke-opacity=".16" stroke-width="1.5" />
    {dial.map((d) => <circle cx={d.x} cy={d.y} r="1.8" fill="#DCE8FA" opacity=".5" />)}
    <g transform="rotate(38)">
      <path d="M0-38 9 0h-18Z" fill="#DCE8FA" />
      <path d="M0 38 9 0h-18Z" fill="#2F7BE5" />
      <path d="M0-38 3.6-22.8h-7.2Z" fill="#F2C230" />
    </g>
    <circle r="4.5" fill="#0B1F3F" stroke="#DCE8FA" stroke-width="1.5" />
  </g>

  <!-- quiet accents -->
  <circle cx="560" cy="380" r="9" fill="none" stroke="#DCE8FA" stroke-opacity=".3" stroke-width="1.5" />
  <circle cx="28" cy="250" r="5" fill="#DCE8FA" opacity=".25" />
</svg>

<style>
  .art { display: block; width: 100%; height: 100%; max-width: none; }
</style>
