---
/**
 * Directory card. `u` is a published projection (src/lib/records.ts) or, in PREVIEW builds only, a raw draft or sample.
 * The data-* attributes the filters read and the chips come from the same helpers as the filter options, so a published
 * card carries only verified levels, languages and intakes; a raw draft carries reported values only in PREVIEW.
 */
import { FIELDS, LEVELS } from '../../lib/fields';
import { formatDate, PREVIEW } from '../../lib/site';
import { fieldsOf, levelsOf, languagesOf, intakesOf } from '../../lib/records';
import { viewClaim } from '../../lib/publication.mjs';
interface Props { u: any; href?: string; draft?: boolean }
const { u, href = `/universities/${u.slug}/`, draft = false } = Astro.props;
const fields = fieldsOf(u.programmes);
const levels = levelsOf(u.programmes);
const langs = languagesOf(u.programmes);
const langVerified = u.programmes.some((p: any) => viewClaim(p.language, { preview: PREVIEW }).state === 'verified');
const intakes = intakesOf(u.programmes);
const hasPrep = u.preparatoryRoutes.length > 0;
// Routes withheld by the publication policy are neither "yes" nor "no": the "no route recorded" filter must not claim them.
const prepState = hasPrep ? 'yes' : typeof u.routesWithheld === 'number' && u.routesWithheld > 0 ? 'tbc' : 'no';
const initials = u.shortName.split(/\s+/).filter((w: string) => /^[A-Z]/.test(w)).slice(0, 3).map((w: string) => w[0]).join('');
// A withheld city (N24 a) reads "To be confirmed" in the projection (data-city keeps that value so the city filter matches).
const cityText = u.editorialWithheld?.city ? 'City to be confirmed' : u.city;
const place = [cityText, u.region].filter((x) => typeof x === 'string' && x.trim()).join(', ');
const hue = [...u.city].reduce((n: number, ch: string) => n + ch.charCodeAt(0), 0) % 40;
// Search key for the directory filter. Astro escapes & and " in attributes but not < >, so markup characters are removed
// (a short name with markup is still shown escaped as text; tests/publication-build.mjs carries such a name).
const searchName = u.shortName.toLowerCase().replace(/[<>]/g, '');
---
<article class="ucard" data-slug={u.slug} data-status={draft ? 'draft' : 'verified'} data-name={searchName} data-city={u.city} data-fields={fields.join(' ')} data-levels={levels.join(' ')} data-languages={langs.join(' ')} data-prep={prepState} data-intakes={intakes.join(' ')} data-publishable={draft ? 'no' : 'yes'}>
  <a class="tile" href={href} aria-hidden="true" tabindex="-1" style={`--h:${hue}`}><span>{initials}</span><span class="city">{cityText}</span></a>
  <div class="body">
    <h2><a href={href}>{u.shortName}</a></h2>
    <p class="loc">{place}</p>
    <div class="chips">
      {fields.map((f) => <span>{((FIELDS as any)[f] ?? FIELDS.other).short}</span>)}
      {levels.map((l) => <span class="lvl">{(LEVELS as any)[l] ?? l}</span>)}
      {langs.map((l) => <span>{l}{!langVerified && ' (pending)'}</span>)}
      {hasPrep && <span>Preparatory route</span>}
    </div>
    <p class="status">
      {!draft ? <span class="badge badge-verified">Verified profile</span> : <span class="badge badge-pending">Draft — verification in progress</span>}
      {u.verification.lastReview && <small> · reviewed {formatDate(u.verification.lastReview)}</small>}
    </p>
    <a class="more" href={href}>View profile →</a>
  </div>
</article>
<style>
  .ucard { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }
  .ucard[hidden] { display: none; } /* the directory filter sets [hidden]; display:flex above would otherwise keep the card visible */
  .tile { display: flex; align-items: flex-end; justify-content: space-between; aspect-ratio: 16 / 7; padding: .9rem 1rem; color: #fff; text-decoration: none; background: linear-gradient(135deg, hsl(calc(214 + var(--h)) 70% 42%), var(--navy-800)); font-family: var(--font-display); }
  .tile span:first-child { font-size: 1.6rem; font-weight: 700; letter-spacing: .02em; }
  .tile .city { font-size: .8rem; opacity: .85; }
  .body { padding: 1rem 1.25rem 1.25rem; display: flex; flex-direction: column; gap: .5rem; flex: 1; }
  h2 { font-size: 1.15rem; margin: 0; }
  h2 a { color: var(--navy-900); text-decoration: none; }
  h2 a:hover { text-decoration: underline; }
  .loc { margin: 0; font-size: .9rem; color: var(--slate); }
  .lvl { background: var(--blue-50) !important; color: var(--navy-800) !important; }
  .status { margin: 0; font-size: .85rem; }
  .status small { color: var(--slate); }
  .more { margin-top: auto; font-weight: 600; text-decoration: none; }
</style>
