---
/** Compact claim renderer for header bands and cards: value + verification state, never a bare unverified value (see Fact.astro). */
import { PREVIEW } from '../../lib/site';
import { viewClaim } from '../../lib/publication.mjs';
interface Props { label: string; claim: unknown; format?: (v: any) => string }
const { label, claim, format } = Astro.props;
const v = viewClaim(claim, { preview: PREVIEW });
const text = v.state !== 'tbc' ? (format ? format(v.value) : Array.isArray(v.value) ? (v.value as unknown[]).join(', ') : String(v.value)) : null;
const state = v.state === 'tbc' || !text ? 'tbc' : v.state;
---
<span class={`chip chip-${state}`}><span class="chip-label">{label}</span> {state === 'tbc' ? 'to be confirmed' : text}{state === 'pending' && <span class="visually-hidden"> (verification pending)</span>}</span>
<style>
  .chip { display: inline-flex; align-items: center; gap: .35rem; border-radius: 999px; padding: .3rem .7rem; font-size: .8rem; background: rgba(255,255,255,.12); color: #fff; border: 1px solid rgba(255,255,255,.25); }
  .chip-label { opacity: .75; }
  .chip-verified { border-color: #7FD0A1; }
  .chip-pending { border-color: var(--yellow-400); }
  .chip-tbc { border-style: dashed; }
  :global(.light) .chip { background: var(--mist); color: var(--ink); border-color: var(--line); }
</style>
