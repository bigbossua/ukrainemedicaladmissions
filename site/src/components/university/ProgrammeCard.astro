---
import Fact from '../Fact.astro';
import RequirementList from './RequirementList.astro';
import DocumentList from './DocumentList.astro';
import { SITE, PREVIEW } from '../../lib/site';
import { FIELDS, LEVELS } from '../../lib/fields';
import { viewClaim, formatMoney } from '../../lib/publication.mjs';
interface Props { p: any; slug: string }
const { p, slug } = Astro.props;
const view = (c: unknown) => viewClaim(c, { preview: PREVIEW });
const field = (FIELDS as any)[p.field] ?? FIELDS.other;
// Amount, currency, basis and academic year, plus the year-by-year amounts and payment schedule exactly as recorded when
// the verified fee carries them (N24 e: the explanation below promises nothing the display does not print).
const money = (m: any) => formatMoney(m);
const level = view(p.level);
const levelLabel = level.state !== 'tbc' && typeof level.value === 'string' ? (LEVELS as any)[level.value] ?? level.value : null;
const intl = view(p.internationalAdmission);
const intakeYear = view(p.intakeYear);
const intakeLabel = intakeYear.state !== 'tbc' && typeof intakeYear.value === 'string' ? intakeYear.value : 'current';
const duration = view(p.durationText).state !== 'tbc' ? p.durationText : p.durationYears;
// Projections (published profiles) carry withheld counts; raw drafts (PREVIEW only) list every item with its status.
const reqWithheld = typeof p.requirementsWithheld === 'number' ? p.requirementsWithheld : 0;
const docWithheld = typeof p.documentsWithheld === 'number' ? p.documentsWithheld : 0;
// A projection drops unverified cost items and counts them: say so, so a missing row is never read as "no other costs".
const costWithheld = typeof p.otherCostsWithheld === 'number' ? p.otherCostsWithheld : 0;
---
<article class="prog" id={p.id}>
  <header class="prog-head">
    <div>
      <p class="family">{field.page ? <a href={field.page}>{field.label}</a> : field.label}{levelLabel && <> · <span class={level.state === 'verified' ? '' : 'tbc'}>{levelLabel}</span>{level.state !== 'verified' && <span class="visually-hidden"> (level pending verification)</span>}</>}</p>
      <h3>{p.name}</h3>
    </div>
    <div class="state">
      {intl.state === 'verified' && intl.value === true ? <span class="badge badge-verified">Open to international applicants (verified)</span> : intl.state === 'verified' && intl.value === false ? <span class="badge badge-pending">Not open to international applicants</span> : <span class="badge badge-pending">International admission to be confirmed</span>}
    </div>
  </header>
  <dl class="facts">
    <Fact label="Qualification awarded" claim={p.qualification} />
    <Fact label="Specialty code" claim={p.specialtyCode} />
    <Fact label="Duration" claim={duration} format={(v) => (typeof v === 'number' ? `${v} years` : String(v))} />
    <Fact label="Language" claim={p.language} />
    <Fact label="Format" claim={p.format} />
    <Fact label="Intake these facts refer to" claim={p.intakeYear} />
    <Fact label="Tuition fee" claim={p.tuition} format={money} tbcText={`The university's fee for the ${intakeLabel} intake has not yet been verified. We publish a fee only as the university states it on its own website: the amount, the currency, what it is charged per (year, semester or whole programme) and the academic year, with the payment schedule and any year-by-year amounts where the university states them, and the date we read it. Never an estimate.`} />
    {p.otherMandatoryCosts.filter((c: any) => PREVIEW || view(c.cost).state === 'verified').map((c: any) => <Fact label={c.label} claim={c.cost} format={money} />)}
    {costWithheld > 0 && <Fact label="Other mandatory costs" claim={null} tbcText="Some other mandatory costs have not yet been verified against the university's official pages, so they are not listed here yet." />}
    <Fact label="Application window" claim={p.deadlines} format={(v) => v.map((x: any) => `${x.label}: ${x.date}`).join('; ')} tbcText="The university's application dates for this intake have not yet been verified. We publish dates only as printed on the official admissions page, with the year." />
    <Fact label="Intake" claim={p.intake} tbcText="The intake start has not yet been verified from the official admissions page." />
  </dl>
  <div class="two">
    <section>
      <h4>Entry requirements{p.requirements.some((r: any) => r.intakeYear) && <small> (intake-specific)</small>}</h4>
      <RequirementList items={p.requirements} withheld={reqWithheld} />
      {PREVIEW && p.gradingNote && <p class="note">{p.gradingNote}</p>}
    </section>
    <section>
      <h4>Documents the university asks for</h4>
      <DocumentList items={p.documents} withheld={docWithheld} />
    </section>
  </div>
  <p class="cta"><a class="btn btn-primary btn-sm" href={`/apply/?university=${slug}&course=${p.field}`}>{SITE.cta}</a> <span class="hint">Free to start; nothing is sent to the university until you confirm.</span></p>
</article>
<style>
  .prog { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.25rem; background: #fff; }
  .prog-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem; align-items: start; margin-bottom: .5rem; }
  .family { margin: 0 0 .25rem; font-size: .85rem; color: var(--slate); }
  .family a { color: var(--blue-600); text-decoration: underline; text-underline-offset: 2px; }
  .prog h3 { margin: 0; }
  .facts { margin: .5rem 0 1rem; }
  .two { display: grid; gap: 1.25rem; }
  .two > section { padding: 0; }
  @media (min-width: 800px) { .two { grid-template-columns: 1fr 1fr; } }
  h4 { font-size: 1rem; margin: 0 0 .5rem; }
  h4 small { font-weight: 400; color: var(--slate); }
  .cta { margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
  .hint { font-size: .85rem; color: var(--slate); }
</style>
