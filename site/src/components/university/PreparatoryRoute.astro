---
import Fact from '../Fact.astro';
interface Props { r: any }
const { r } = Astro.props;
const money = (m: any) => `${m.amount.toLocaleString('en-GB')} ${m.currency} per ${m.per} (${m.academicYear})`;
const yesno = (v: boolean) => (v ? 'Yes' : 'No');
---
<article class="prep" id={r.id}>
  <h3>{r.name}</h3>
  <dl>
    <Fact label="Language of instruction" claim={r.languageOfInstruction} />
    <Fact label="English-language track" claim={r.englishTrack} format={yesno} />
    <Fact label="Duration" claim={r.durationText} />
    <Fact label="Subjects" claim={r.subjects} />
    <Fact label="Start" claim={r.startDate} />
    <Fact label="Certificate awarded" claim={r.certificateName} />
    <Fact label="Open to English-degree applicants" claim={r.appliesToEnglishDegreeTrack} format={yesno} />
    <Fact label="Fee" claim={r.fee} format={money} />
    <Fact label="Eligibility (university wording)" claim={r.eligibilityText} />
  </dl>
  <div class="progression">
    <h4>What completing the course gives — in the university's own words</h4>
    {r.progressionText.status === 'verified' && r.progressionText.value ? <blockquote>“{r.progressionText.value}”</blockquote> : <p class="note">The university's wording on progression has not yet been verified; nothing is assumed.</p>}
    <p class="standing">A preparatory course improves academic preparation. It does not guarantee admission, progression or a place on any degree programme; the degree's own entry requirements still apply.</p>
  </div>
  {r.note && <small class="src">{r.note}</small>}
</article>
<style>
  .prep { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; background: var(--blue-50); }
  .prep h3 { margin-bottom: .5rem; }
  .progression { margin-top: 1rem; }
  .progression h4 { font-size: .95rem; margin-bottom: .4rem; }
  blockquote { margin: 0 0 .5rem; padding: .75rem 1rem; border-left: 4px solid var(--blue-600); background: #fff; border-radius: 8px; }
  .standing { font-size: .9rem; color: var(--slate); margin: 0; }
  .src { display: block; margin-top: .75rem; color: var(--slate); font-size: .78rem; }
  dl { margin: 0; }
</style>
