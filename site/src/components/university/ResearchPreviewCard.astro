---
/**
 * Directory card for a RESEARCH PREVIEW (N25): an unpublished record shown by its short name with the REPORTED leads of
 * the projection (owner decision (g) 2026-10-25): the city and the programme areas (family names only, at most four,
 * then "+n"). The institution type is the group the card sits in, so it is not repeated here. `u` is the policy
 * projection (src/lib/records.ts getResearchPreviews), never a raw record, so a verified fact can appear only once the
 * evidence store verifies it; the card prints no fee, date, address or programme name. The status line says
 * "Not yet verified" on every card; the directory page states above the list that city and programme areas are reported
 * in public sources. One link per card ("View details"), stretched over the whole card.
 * data-* attributes feed the directory search and filters: name, status, kind (by name), and the reported type, city and
 * programme areas.
 */
import { shownFactCount } from '../../lib/records';
import { nameKind } from '../../lib/name-search.mjs';
import { FIELDS } from '../../lib/fields';
interface Props { u: any; headingLevel?: 'h2' | 'h3' | 'h4' }
const { u, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const href = `/universities/${u.slug}/`;
const verified = shownFactCount(u);
const rep = u.reported && typeof u.reported === 'object' ? u.reported : null;
const rFields: string[] = Array.isArray(rep?.programmeFields) ? rep.programmeFields : [];
const MAX_CHIPS = 4;
const chips = rFields.slice(0, MAX_CHIPS).map((f) => (FIELDS as any)[f]?.short ?? f);
const more = rFields.length - chips.length;
const moreNames = rFields.slice(MAX_CHIPS).map((f) => (FIELDS as any)[f]?.short ?? f).join(', ');
// Search key for the directory filter. Astro escapes & and " in attributes but not < >, so markup characters are removed
// (the policy refuses such a short name for a preview anyway; tests/publication-build.mjs covers published names).
const searchName = u.shortName.toLowerCase().replace(/[<>]/g, '');
---
<article class="pcard" data-slug={u.slug} data-status="preview" data-name={searchName} data-kind={nameKind(u.shortName)} data-type={rep?.institutionType ?? ''} data-rcity={rep?.city ?? ''} data-rfields={rFields.join(' ')}>
  <Heading class="name">{u.shortName}</Heading>
  {rep?.city && <p class="city"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="2.3" fill="currentColor"/></svg><span class="visually-hidden">City: </span>{rep.city}</p>}
  {chips.length > 0 && (
    <ul class="areas" aria-label="Programme areas">
      {chips.map((c) => <li>{c}</li>)}
      {more > 0 && <li class="more-areas" title={moreNames}>+{more}<span class="visually-hidden"> more: {moreNames}</span></li>}
    </ul>
  )}
  <div class="foot">
    <span class="status"><span class="dot" aria-hidden="true"></span>Not yet verified{verified > 0 && <span class="facts"> · {verified} {verified === 1 ? 'fact' : 'facts'} verified</span>}</span>
    <a class="more" href={href}>View details<span class="visually-hidden">: {u.shortName}</span> <span aria-hidden="true">→</span></a>
  </div>
</article>
<style>
  .pcard { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1.25rem 1rem; display: flex; flex-direction: column; gap: .65rem; min-width: 0; transition: border-color .2s, box-shadow .2s, transform .2s; }
  .pcard:hover { border-color: var(--blue-100); box-shadow: 0 14px 30px rgba(11, 31, 63, .08); transform: translateY(-2px); }
  .pcard:focus-within { border-color: var(--blue-600); box-shadow: 0 0 0 3px var(--blue-100); }
  .pcard[hidden] { display: none; } /* the directory filter sets [hidden]; display:flex above would otherwise keep the card visible */
  .name { font-size: 1.1rem; font-weight: 650; margin: 0; line-height: 1.3; color: var(--navy-900); overflow-wrap: anywhere; }
  .city { display: flex; align-items: center; gap: .35rem; margin: 0; color: var(--slate); font-size: .95rem; }
  .city svg { flex: none; color: var(--blue-600); }
  .areas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem; }
  .areas li { font-size: .82rem; font-weight: 500; color: var(--navy-800); background: var(--blue-50); border-radius: 999px; padding: .2rem .65rem; }
  .areas .more-areas { background: var(--mist); color: var(--slate); }
  .foot { margin-top: auto; padding-top: .65rem; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: .5rem 1rem; flex-wrap: wrap; }
  .status { display: inline-flex; align-items: center; gap: .45rem; font-size: .85rem; color: var(--slate); }
  .dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--yellow-400); box-shadow: 0 0 0 3px var(--yellow-100); flex: none; }
  .facts { color: var(--slate); }
  .more { font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: .3em; min-height: 44px; }
  .more::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .pcard:hover .more { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { .pcard:hover { transform: none; } }
</style>
