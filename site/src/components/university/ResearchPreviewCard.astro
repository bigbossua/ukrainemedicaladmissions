---
/**
 * Directory card for a RESEARCH PREVIEW (N25): an unpublished record shown by its short name only, labelled
 * "Not yet verified". `u` is the policy projection (src/lib/records.ts getResearchPreviews), never a raw record, so a
 * verified fact can appear here only once the evidence store verifies it. The card prints no city, programme, fee or
 * other claim; when the projection shows facts it counts them. Since 2026-10-25 (owner instruction, publication-config
 * REPORTED_LEADS_ON_PREVIEWS) it also prints the REPORTED leads of the projection (`u.reported`: city, institution type
 * and programme areas), each under the word "Reported", never a programme name, fee, date or address. data-* attributes
 * feed the directory search and filters: name, status, kind (by name), and the reported type, city and programme areas.
 * Compact by design: the caveat is said once per page, not on every card.
 */
import { shownFactCount } from '../../lib/records';
import { nameKind } from '../../lib/name-search.mjs';
import { FIELDS } from '../../lib/fields';
import { typeLabel } from '../../lib/institution-types';
interface Props { u: any; headingLevel?: 'h2' | 'h3' | 'h4' }
const { u, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const href = `/universities/${u.slug}/`;
const verified = shownFactCount(u);
const rep = u.reported && typeof u.reported === 'object' ? u.reported : null;
const place = rep?.city ? [rep.city, rep.region].filter(Boolean).join(', ') : '';
const rType = typeLabel(rep?.institutionType);
const rFields: string[] = Array.isArray(rep?.programmeFields) ? rep.programmeFields : [];
const rFieldLabels = rFields.map((f) => (FIELDS as any)[f]?.short ?? f);
// Search key for the directory filter. Astro escapes & and " in attributes but not < >, so markup characters are removed
// (the policy refuses such a short name for a preview anyway; tests/publication-build.mjs covers published names).
const searchName = u.shortName.toLowerCase().replace(/[<>]/g, '');
---
<article class="pcard card-link" data-slug={u.slug} data-status="preview" data-name={searchName} data-kind={nameKind(u.shortName)} data-type={rep?.institutionType ?? ''} data-rcity={rep?.city ?? ''} data-rfields={rFields.join(' ')}>
  <Heading class="name">{u.shortName}</Heading>
  {(place || rType) && <p class="rep"><span class="rep-label">Reported</span> {[place, rType].filter(Boolean).join(' · ')}</p>}
  {rFieldLabels.length > 0 && <p class="chips" aria-label="Programme areas reported, not yet verified">{rFieldLabels.map((f) => <span>{f}</span>)}</p>}
  <p class="tag"><span class="badge badge-pending"><span aria-hidden="true">◔ </span>Not yet verified</span>{verified > 0 && <span class="facts"> {verified} {verified === 1 ? 'fact' : 'facts'} verified</span>}</p>
  <a class="more" href={href}>What to check before you apply<span class="visually-hidden">: {u.shortName}</span> →</a>
</article>
<style>
  .pcard { background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--yellow-400); border-radius: var(--radius-sm); padding: .9rem 1.1rem; display: flex; flex-direction: column; gap: .45rem; min-height: 48px; }
  .pcard:focus-within { outline: 3px solid var(--blue-600); outline-offset: 2px; }
  .pcard[hidden] { display: none; } /* the directory filter sets [hidden]; display:flex above would otherwise keep the card visible */
  .name { font-size: 1.05rem; margin: 0; line-height: 1.3; color: var(--navy-900); }
  .rep { margin: 0; font-size: .88rem; color: var(--slate); }
  .rep-label { font-size: .72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--navy-800); background: var(--blue-50); border-radius: 3px; padding: .05rem .35rem; margin-right: .3rem; }
  .chips { margin: 0; display: flex; flex-wrap: wrap; gap: .3rem; }
  .chips span { font-size: .78rem; background: #F4F6FA; border: 1px solid var(--line); border-radius: 999px; padding: .12rem .55rem; color: var(--navy-800); }
  .tag { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
  .facts { font-size: .85rem; color: var(--slate); }
  .more { margin-top: auto; font-weight: 600; text-decoration: none; font-size: .95rem; display: inline-flex; align-items: center; gap: .3em; min-height: 44px; }
</style>
